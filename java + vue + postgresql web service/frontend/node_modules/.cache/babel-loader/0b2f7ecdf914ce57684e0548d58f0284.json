{"ast":null,"code":"import { getTableRecords1 } from \"@/getTableRecords\";\nimport axios from \"axios\";\nexport default {\n  name: \"Type_propertiesTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        offset: 0\n      },\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    nextPage() {\n      this.params.offset++;\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    prevPage() {\n      this.params.offset--;\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async createEntity() {\n      try {\n        await axios.post(this.link, this.form);\n        this.getTable();\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  }\n};","map":{"version":3,"mappings":"AAiBA,SAAQA,gBAAR,QAA+B,mBAA/B;AACA,OAAOC,KAAP,MAAkB,OAAlB;AAEA,eAAe;EACbC,IAAI,EAAE,sBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMXC,IAAI,GAAG;IACP,OAAO;MACLC,MAAM,EAAE;QAACC,MAAM,EAAE;MAAT,CADH;MAELC,SAAS,EAAE;IAFN,CAAP;EAID,CAXY;;EAYbC,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CAdY;;EAebC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACTX,gBAAgB,CAAC,KAAKI,IAAN,EAAY,KAAKG,MAAjB,CAAhB,CAAyCM,IAAzC,CAA+CC,GAAD,IAAS;QAAE,KAAKL,SAAL,GAAiBK,GAAjB;MAAqB,CAA9E;IACD,CAHM;;IAIPC,QAAQ,GAAE;MACP,KAAKR,MAAL,CAAYC,MAAZ;MACCR,gBAAgB,CAAC,KAAKI,IAAN,EAAY,KAAKG,MAAjB,CAAhB,CAAyCM,IAAzC,CAA+CC,GAAD,IAAS;QAAE,KAAKL,SAAL,GAAiBK,GAAjB;MAAqB,CAA9E;IACH,CAPM;;IAQPE,QAAQ,GAAE;MACR,KAAKT,MAAL,CAAYC,MAAZ;MACAR,gBAAgB,CAAC,KAAKI,IAAN,EAAY,KAAKG,MAAjB,CAAhB,CAAyCM,IAAzC,CAA+CC,GAAD,IAAS;QAAE,KAAKL,SAAL,GAAiBK,GAAjB;MAAqB,CAA9E;IACD,CAXM;;IAYP,MAAMG,YAAN,GAAqB;MACnB,IAAI;QACF,MAAMhB,KAAK,CAACiB,IAAN,CAAW,KAAKd,IAAhB,EAAsB,KAAKe,IAA3B,CAAN;QACA,KAAKR,QAA