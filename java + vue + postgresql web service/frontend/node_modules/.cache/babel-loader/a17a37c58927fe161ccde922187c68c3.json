{"ast":null,"code":"import tables from \"@/data/tables\";\nimport queries from \"@/data/queries\";\nimport { ref } from \"vue\";\nexport default {\n  name: \"NavbarMenu\",\n  methods: {\n    handle(name) {\n      this.$router.push({\n        name: name\n      });\n    },\n\n    async logout() {\n      localStorage.setItem('role', '0');\n      const r = localStorage.getItem('role');\n    },\n\n    async login() {\n      localStorage.setItem('role', '1');\n    },\n\n    secondHandle(name, path) {\n      this.$router.push({\n        name: name,\n        params: {\n          link: path,\n          name: name\n        }\n      });\n    }\n\n  },\n\n  setup() {\n    const allTables = ref(tables);\n    const allQueries = ref(queries);\n    return {\n      allTables,\n      allQueries\n    };\n  }\n\n};","map":{"version":3,"mappings":"AAsDA,OAAOA,MAAP,MAAmB,eAAnB;AACA,OAAOC,OAAP,MAAoB,gBAApB;AACA,SAAQC,GAAR,QAAkB,KAAlB;AAEA,eAAe;EACbC,IAAI,EAAE,YADO;EAEbC,OAAO,EAAE;IACPC,MAAM,CAACF,IAAD,EAAO;MACX,KAAKG,OAAL,CAAaC,IAAb,CAAkB;QAACJ,IAAI,EAAEA;MAAP,CAAlB;IACD,CAHM;;IAIP,MAAMK,MAAN,GAAe;MACbC,YAAY,CAACC,OAAb,CAAqB,MAArB,EAA6B,GAA7B;MACA,MAAMC,IAAIF,YAAY,CAACG,OAAb,CAAqB,MAArB,CAAV;IACD,CAPM;;IAQP,MAAMC,KAAN,GAAc;MACZJ,YAAY,CAACC,OAAb,CAAqB,MAArB,EAA6B,GAA7B;IACD,CAVM;;IAWPI,YAAY,CAACX,IAAD,EAAOY,IAAP,EAAa;MACvB,KAAKT,OAAL,CAAaC,IAAb,CAAkB;QAChBJ,IAAI,EAAEA,IADU;QAEhBa,MAAM,EAAE;UACNC,IAAI,EAAEF,IADA;UAENZ,IAAI,EAAEA;QAFA;MAFQ,CAAlB;IAMF;;EAlBO,CAFI;;EAsBbe,KAAK,GAAG;IACN,MAAMC,SAAQ,GAAIjB,GAAG,CAACF,MAAD,CAArB;IACA,MAAMoB,UAAS,GAAIlB,GAAG,CAACD,OAAD,CAAtB;IACA,OAAO;MAACkB,SAAD;MAAYC;IAAZ,CAAP;EACF;;AA1Ba,CAAf","names":["tables","queries","ref","name","methods","handle","$router","push","logout","localStorage","setItem","r","getItem","login","secondHandle","path","params","link","setup","allTables","allQueries"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\work\\bdbdbdbdbdbd\\1\\1lab\\frontend\\src\\components\\NavbarMenu.vue"],"sourcesContent":["<template>\n\n  <div class=\"navbar\"/>\n  <el-menu\n      class=\"el-menu-demo\"\n      mode=\"horizontal\"\n      background-color=\"#22a2e3\"\n      text-color=\"#ffffff\"\n      active-text-color=\"#ffffff\"\n  >\n    <el-menu-item index=\"1\"\n                  @click=\"this.handle('Home Page')\">\n      Home\n    </el-menu-item>\n\n    <el-sub-menu index=\"2\">\n      <template #title>Tables</template>\n      <el-menu-item v-for=\"tbl in this.allTables\"\n                    v-bind:key=\"tbl.name\"\n                    :index=\"'2-'+tbl.id\"\n                    @click=\"this.secondHandle(tbl.name, tbl.path)\">\n                    \n        {{ tbl.name }}\n      </el-menu-item>\n    </el-sub-menu>\n\n    <el-sub-menu index=\"3\">\n      <template #title>Queries</template>\n      <el-menu-item v-for=\"qrs in this.allQueries\"\n                    v-bind:key=\"qrs.name\"\n                    :index=\"'3-'+qrs.id\"\n                    @click=\"this.secondHandle(qrs.name, qrs.path)\">\n        {{ qrs.name }}\n      </el-menu-item>\n    </el-sub-menu>\n      <div v-if=\"localStorage.getItem('role')==='0'\">\n      <el-menu-item index=\"5\"\n                  @click=\"this.$router.push('/login');login();\">\n      Login\n    </el-menu-item>\n      </div>\n      <el-menu-item index=\"6\"\n                  @click=\"this.handle('Registration Page')\">\n      Registration\n    </el-menu-item>\n    <sec:authorize access=\"isAuthenticated()\">\n      <el-menu-item index=\"7\" @click=\"this.$router.push('/logout');logout();\">\n      Logout\n    </el-menu-item>\n</sec:authorize>\n  </el-menu>\n</template>\n\n<script>\nimport tables from \"@/data/tables\";\nimport queries from \"@/data/queries\"\nimport {ref} from \"vue\";    \n\nexport default {\n  name: \"NavbarMenu\",\n  methods: {\n    handle(name) {\n      this.$router.push({name: name})\n    },\n    async logout() {\n      localStorage.setItem('role', '0');\n      const r = localStorage.getItem('role');\n    },\n    async login() {\n      localStorage.setItem('role', '1');\n    },\n    secondHandle(name, path) {\n      this.$router.push({\n        name: name,\n        params: {\n          link: path,\n          name: name\n        }})\n    }\n  },\n  setup() {\n    const allTables = ref(tables)\n    const allQueries = ref(queries)\n    return {allTables, allQueries}\n  }\n}\n</script>\n\n<style scoped>\n\n</style>"]},"metadata":{},"sourceType":"module"}