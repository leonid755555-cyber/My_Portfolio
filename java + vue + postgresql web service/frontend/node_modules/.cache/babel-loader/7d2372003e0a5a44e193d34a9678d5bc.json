urname","patronymic","mounted","getTable","methods","then","ret","deleteEntity","idx","id","rows","confirm","confirmButtonText","cancelButtonText","type","delete","splice","message","e","console","log","createEntity","response","post","allWorkerOptions","push","value","label","setup"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\nsu-database-main\\frontend\\src\\components\\Tables\\WorkerTable.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n\n    <div class=\"createForm\">\n      <el-form :model=\"form\">\n        <el-form-item label=\"Worker surname\">\n          <el-input v-model=\"form.surname\" />\n        </el-form-item>\n\n        <el-form-item label=\"Worker name\">\n          <el-input v-model=\"form.name\" />\n        </el-form-item>\n\n        <el-form-item label=\"Worker patronymic\">\n          <el-input v-model=\"form.patronymic\" />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button class=\"submit\" type=\"success\" round @click=\"createEntity\">Create</el-button>\n\n        </el-form-item>\n      </el-form>\n    </div>\n\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n      <el-table-column label=\"Delete Record\">\n        <template #default=\"scope\">\n          <el-button type=\"danger\" round  v-on:click=\"deleteEntity(scope.$index)\">Delete</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {ElMessage, ElMessageBox} from \"element-plus\";\nimport axios from \"axios\";\nimport {reactive} from \"vue\";\nimport {ref} from \"vue\";\nimport {workerIdParamOptions} from \"@/data/parameters\";\n\nexport default {\n  name: \"WorkerTable\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        surname: '',\n        name: '',\n        patronymic: '',\n      })\n    }\n  },\n  mounted() {\n    this.getTable()\n  },\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then((ret) => { this.tableData = ret})\n    },\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\",\n          'Warning',\n          {\n            confirmButtonText: 'OK',\n            cancelButtonText: 'Cancel',\n            type: 'warning',\n          })) {\n        try {\n          await axios.delete(this.link + \"/\" + id)\n          this.tableData.rows.splice(idx, 1)\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted',\n          })\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted',\n          });\n        }\n      }\n    },\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form)\n        this.getTable()\n        this.allWorkerOptions.push({\n          value: response.data.id,\n          label: response.data.surname + ' ' + response.data.name + ' ' + response.data.patronymic,\n        })\n      } catch (e) {\n        console.log(e);\n      }\n    }\n  },\n  setup() {\n    const allWorkerOptions = ref(workerIdParamOptions)\n    return {allWorkerOptions}\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22c0c2;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}