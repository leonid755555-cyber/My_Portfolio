{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive } from \"vue\";\nexport default {\n  name: \"PlacesTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        name: ''\n      })\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form);\n        this.getTable();\n        this.allpersonIdOptions.push({\n          value: response.data.id,\n          label: response.data.FIO\n        });\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  }\n};","map":{"version":3,"mappings":"AA8BA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AAEA,eAAe;EACbC,IAAI,EAAE,aADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,SAAS,EAAE,EADN;MAELC,IAAI,EAAEP,QAAQ,CAAC;QACXC,IAAI,EAAE;MADK,CAAD;IAFT,CA