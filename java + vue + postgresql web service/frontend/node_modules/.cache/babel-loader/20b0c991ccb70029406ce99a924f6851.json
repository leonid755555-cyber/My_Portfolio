{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nexport default {\n  name: \"PartsTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    }\n\n  }\n};","map":{"version":3,"mappings":"AAiBA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AAEA,eAAe;EACbC,IAAI,EAAE,YADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMXC,IAAI,GAAG;IACP,OAAO;MACLC,SAAS,EAAE;IADN,CAAP;EAGD,CAVY;;EAWbC,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CAbY;;EAcbC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACTX,eAAe,CAAC,KAAKM,IAAN,EAAY,IAAZ,CAAf,CAAiCO,IAAjC,CAAuCC,GAAD,IAAS;QAAE,KAAKL,SAAL,GAAiBK,GAAjB;MAAqB,CAAtE;IACD,CAHM;;IAIP,MAAMC,YAAN,CAAmBC,GAAnB,EAAwB;MACtB,IAAIC,EAAC,GAAI,KAAKR,SAAL,CAAeS,IAAf,CAAoBF,GAApB,EAAyBC,EAAlC;;MACA,IAAI,MAAMf,YAAY,CAACiB,OAAb,CAAqB,2CAArB,EACN,SADM,EAEN;QACEC,iBAAiB,EAAE,IADrB;QAEEC,gBAAgB,EAAE,QAFpB;QAGEC,IAAI,EAAE;MAHR,CAFM,CAAV,EAMQ;QACN,IAAI;UACF,MAAMnB,KAAK,CAACoB,MAAN,CAAa,KAAKjB,IAAL,GAAY,GAAZ,GAAkBW,EAA/B,CAAN;UACA,KAAKR,SAAL,CAAeS,IAAf,CAAoBM,MAApB,CAA2BR,GAA3B,EAAgC,CAAhC;UACAf,SAAS,CAAC;YACRqB,IAAI,EAAE,SADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF,CAPA,CAOE,OAAOC,CAAP,EAAU;UACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;UACAzB,SAAS,CAAC;YACRqB,IAAI,EAAE,MADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF;MACF;IACF;;EA5BO;AAdI,CAAf","names":["getTableRecords","ElMessage","ElMessageBox","axios","name","props","link","String","data","tableData","mounted","getTable","methods","then","ret","deleteEntity","idx","id","rows","confirm","confirmButtonText","cancelButtonText","type","delete","splice","message","e","console","log"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\bdbdbdbdbdbd\\1\\frontend\\src\\components\\Tables\\PartsTable.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n      <el-table-column label=\"Delete Record\">\n        <template #default=\"scope\">\n          <el-button type=\"danger\" round  v-on:click=\"deleteEntity(scope.$index)\">Delete</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {ElMessage, ElMessageBox} from \"element-plus\";\nimport axios from \"axios\";\n\nexport default {\n  name: \"PartsTable\",\n  props: {\n    link: String,\n    name: String\n  },\n    data() {\n    return {\n      tableData: {}\n    }\n  },\n  mounted() {\n    this.getTable()\n  },\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then((ret) => { this.tableData = ret})\n    },\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\",\n          'Warning',\n          {\n            confirmButtonText: 'OK',\n            cancelButtonText: 'Cancel',\n            type: 'warning',\n          })) {\n        try {\n          await axios.delete(this.link + \"/\" + id)\n          this.tableData.rows.splice(idx, 1)\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted',\n          })\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted',\n          });\n        }\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n</style>"]},"metadata":{},"sourceType":"module"}