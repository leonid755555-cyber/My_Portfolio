{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { managementIdParamOptions } from \"@/data/parameters\";\nimport { ref } from \"vue\";\nexport default {\n  name: \"EquipmentListQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        managementIdParam: null\n      },\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.updateData();\n  },\n\n  methods: {\n    updateData() {\n      getTableRecords(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    }\n\n  },\n\n  setup() {\n    const allManagementOptions = ref(managementIdParamOptions);\n    return {\n      allManagementOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AAmBA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,wBAAR,QAAuC,mBAAvC;AACA,SAAQC,GAAR,QAAkB,KAAlB;AAEA,eAAe;EACbC,IAAI,EAAE,oBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MAACC,MAAM,EAAE;QAACC,iBAAiB,EAAE;MAApB,CAAT;MAAoCC,SAAS,EAAE;IAA/C,CAAP;EACD,CARY;;EASbC,OAAO,GAAG;IACR,KAAKC,UAAL;EACD,CAXY;;EAYbC,OAAO,EAAE;IACPD,UAAU,GAAG;MACXZ,eAAe,CAAC,KAAKK,IAAN,EAAY,KAAKG,MAAjB,CAAf,CAAwCM,IAAxC,CAA8CC,GAAD,IAAS;QAAE,KAAKL,SAAL,GAAiBK,GAAjB;MAAqB,CAA7E;IACF;;EAHO,CAZI;;EAiBbC,KAAK,GAAG;IACN,MAAMC,oBAAmB,GAAIf,GAAG,CAACD,wBAAD,CAAhC;IACA,OAAO;MAACgB;IAAD,CAAP;EACF;;AApBa,CAAf","names":["getTableRecords","managementIdParamOptions","ref","name","props","link","String","data","params","managementIdParam","tableData","mounted","updateData","methods","then","ret","setup","allManagementOptions"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\bdbdbdbdbdbd\\1\\frontend\\src\\components\\Queries\\EquipmentListQuery.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n    <el-select-v2\n        class=\"selectDropdown\"\n        v-model=\"this.params.managementIdParam\"\n        :options=\"this.allManagementOptions\"\n        placeholder=\"Select Management\"\n    />\n    <el-button class=\"submit\" type=\"success\" round @click=\"this.updateData()\">Submit</el-button>\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {managementIdParamOptions} from \"@/data/parameters\";\nimport {ref} from \"vue\";\n\nexport default {\n  name: \"EquipmentListQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {params: {managementIdParam: null}, tableData: {}}\n  },\n  mounted() {\n    this.updateData()\n  },\n  methods: {\n    updateData() {\n      getTableRecords(this.link, this.params).then((ret) => { this.tableData = ret})\n    }\n  },\n  setup() {\n    const allManagementOptions = ref(managementIdParamOptions)\n    return {allManagementOptions}\n  }\n}\n</script>\n\n<style scoped>\n.submit {\n  margin-left: 20px;\n  margin-bottom: 30px;\n}\n\n.selectDropdown {\n  margin-bottom: 30px;\n}\n\nh1 {\n  position: center;\n  font-size: 50px;\n  font-family: \"Akshar\";\n}\n</style>"]},"metadata":{},"sourceType":"module"}