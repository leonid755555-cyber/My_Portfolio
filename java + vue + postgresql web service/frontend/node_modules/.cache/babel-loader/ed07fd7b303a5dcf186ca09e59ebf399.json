{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { siteIdParamOptions } from \"@/data/parameters\";\nimport { ref } from \"vue\";\nexport default {\n  name: \"ObjectListQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        siteIdParam: null\n      },\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.updateData();\n  },\n\n  methods: {\n    updateData() {\n      getTableRecords(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    }\n\n  },\n\n  setup() {\n    const allSiteOptions = ref(siteIdParamOptions);\n    return {\n      allSiteOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AAmBA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,kBAAR,QAAiC,mBAAjC;AACA,SAAQC,GAAR,QAAkB,KAAlB;AAEA,eAAe;EACbC,IAAI,EAAE,iBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,MAAM,EAAE;QAACC,WAAW,EAAE;MAAd,CADH;MAELC,SAAS,EAAE;IAFN,CAAP;EAID,CAXY;;EAYbC,OAAO,GAAG;IACR,KAAKC,UAAL;EACD,CAdY;;EAebC,OAAO,EAAE;IACPD,UAAU,GAAG;MACXZ,eAAe,CAAC,KAAKK,IAAN,EAAY,KAAKG,MAAjB,CAAf,CAAwCM,IAAxC,CAA8CC,GAAD,IAAS;QAAE,KAAKL,SAAL,GAAiBK,GAAjB;MAAqB,CAA7E;IACF;;EAHO,CAfI;;EAoBbC,KAAK,GAAG;IACN,MAAMC,cAAa,GAAIf,GAAG,CAACD,kBAAD,CAA1B;IACA,OAAO;MAACgB;IAAD,CAAP;EACF;;AAvBa,CAAf","names":["getTableRecords","siteIdParamOptions","ref","name","props","link","String","data","params","siteIdParam","tableData","mounted","updateData","methods","then","ret","setup","allSiteOptions"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\nsu-database-main\\frontend\\src\\components\\Queries\\ObjectListQuery.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n    <el-select-v2\n        class=\"selectDropdown\"\n        v-model=\"this.params.siteIdParam\"\n        :options=\"this.allSiteOptions\"\n        placeholder=\"Select Site\"\n    />\n    <el-button class=\"submit\" type=\"success\" round @click=\"this.updateData()\">Submit</el-button>\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {siteIdParamOptions} from \"@/data/parameters\";\nimport {ref} from \"vue\";\n\nexport default {\n  name: \"ObjectListQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {\n      params: {siteIdParam: null},\n      tableData: {}\n    }\n  },\n  mounted() {\n    this.updateData()\n  },\n  methods: {\n    updateData() {\n      getTableRecords(this.link, this.params).then((ret) => { this.tableData = ret})\n    }\n  },\n  setup() {\n    const allSiteOptions = ref(siteIdParamOptions)\n    return {allSiteOptions}\n  }\n}\n</script>\n\n<style scoped>\n.submit {\n  margin-left: 20px;\n  margin-bottom: 30px;\n}\n\n.selectDropdown {\n  margin-bottom: 30px;\n}\nh1 {\n  position: center;\n  font-size: 50px;\n  font-family: \"Akshar\";\n}\n</style>"]},"metadata":{},"sourceType":"module"}