{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive } from \"vue\";\nimport { ref } from \"vue\";\nimport { autoIdParamOptions, personIdParamOptions } from \"@/data/parameters\";\nconst dialogFormVisible = ref(false);\nexport default {\n  name: \"Repair_reportsTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        transportId: '',\n        emplId: '',\n        date_of_receipt: '',\n        completion_date: '',\n        cost: null,\n        work_type: ''\n      }),\n      form1: reactive({\n        id: '',\n        transportId: '',\n        emplId: '',\n        date_of_receipt: '',\n        completion_date: '',\n        cost: null,\n        work_type: ''\n      }),\n      dialogFormVisible\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    async createEntity() {\n      try {\n        await axios.post(this.link, this.form);\n        this.getTable();\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  },\n\n  async updateEntity() {\n    try {\n      await axios.post(this.link, this.form1);\n      this.getTable();\n      ElMessage({\n        type: 'success',\n        message: 'Successfully updated'\n      });\n    } catch (e) {\n      console.log(e);\n      ElMessage({\n        type: 'info',\n        message: 'Unsuccessfully updated'\n      });\n    }\n  },\n\n  setup() {\n    const allAutoIdOptions = ref(autoIdParamOptions);\n    const allEmplIdOptions = ref(personIdParamOptions);\n    return {\n      allAutoIdOptions,\n      allEmplIdOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AAqFA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AACA,SAAQC,GAAR,QAAkB,KAAlB;AACA,SAAQC,kBAAR,EAA4BC,oBAA5B,QAAuD,mBAAvD;AACA,MAAMC,iBAAgB,GAAIH,GAAG,CAAC,KAAD,CAA7B;AAEA,eAAe;EACbI,IAAI,EAAE,qBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,SAAS,EAAE,EADN;MAELC,IAAI,EAAEX,QAAQ,CAAC;QACbY,WAAW,EAAE,EADA;QAEbC,MAAM,EAAE,EAFK;QAGbC,eAAe,EAAE,EAHJ;QAIbC,eAAe,EAAE,EAJJ;QAKbC,IAAI,EAAE,IALO;QAMbC,SAAS,EAAE;MANE,CAAD,CAFT;MAULC,KAAK,EAAElB,QAAQ,CAAC;QACdmB,EAAE,EAAE,EADU;QAEdP,WAAW,EAAE,EAFC;QAGdC,MAAM,EAAE,EAHM;QAIdC,eAAe,EAAE,EAJH;QAKdC,eAAe,EAAE,EALH;QAMdC,IAAI,EAAE,IANQ;QAOdC,SAAS,EAAE;MAPG,CAAD,CAVV;MAoBLb;IApBK,CAAP;EAsBD,CA7BY;;EA8BbgB,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CAhCY;;EAiCbC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACTzB,eAAe,CAAC,KAAKW,IAAN,EAAY,IAAZ,CAAf,CAAiCgB,IAAjC,CAAuCC,GAAD,IAAS;QAAE,KAAKd,SAAL,GAAiBc,GAAjB;MAAqB,CAAtE;IACD,CAHM;;IAIP,MAAMC,YAAN,CAAmBC,GAAnB,EAAwB;MACtB,IAAIP,EAAC,GAAI,KAAKT,SAAL,CAAeiB,IAAf,CAAoBD,GAApB,EAAyBP,EAAlC;;MACA,IAAI,MAAMrB,YAAY,CAAC8B,OAAb,CAAqB,2CAArB,EACN,SADM,EAEN;QACEC,iBAAiB,EAAE,IADrB;QAEEC,gBAAgB,EAAE,QAFpB;QAGEC,IAAI,EAAE;MAHR,CAFM,CAAV,EAMQ;QACN,IAAI;UACF,MAAMhC,KAAK,CAACiC,MAAN,CAAa,KAAKzB,IAAL,GAAY,GAAZ,GAAkBY,EAA/B,CAAN;UACA,KAAKT,SAAL,CAAeiB,IAAf,CAAoBM,MAApB,CAA2BP,GAA3B,EAAgC,CAAhC;UACA7B,SAA