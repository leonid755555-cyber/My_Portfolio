{"ast":null,"code":"import { getTableRecords1 } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive } from \"vue\";\nexport default {\n  name: \"PartsTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        offset: 0\n      },\n      tableData: {},\n      form: reactive({\n        name: ''\n      }),\n      form1: reactive({\n        name: ''\n      })\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    nextPage() {\n      this.params.offset++;\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    prevPage() {\n      this.params.offset--;\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    async updateEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n      ElMessageBox.prompt('name', 'Tip', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        inputErrorMessage: 'Invalid Email'\n      }).then(async ({\n        value\n      }) => {\n        this.form1.id = id;\n        this.form1.name = value;\n\n        try {\n          const response = await axios.post(this.link, this.form1);\n          this.getTable();\n          this.allpersonIdOptions.push({\n            value: response.data.id,\n            label: response.data.FIO\n          });\n        } catch (e) {\n          console.log(e);\n        }\n      });\n    },\n\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form);\n        this.getTable();\n        this.allpersonIdOptions.push({\n          value: response.data.id,\n          label: response.data.FIO\n        });\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  }\n};","map":{"version":3,"mappings":"AAwCA,SAAQA,gBAAR,QAA+B,mBAA/B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AAEA,eAAe;EACbC,IAAI,EAAE,YADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMXC,IAAI,GAAG;IACP,OAAO;MACLC,MAAM,EAAE;QAACC,MAAM,EAAE;MAAT,CADH;MAELC,SAAS,EAAE,EAFN;MAGLC,IAAI,EAAET,QAAQ,CAAC;QACXC,IAAI,EAAE;MADK,CAAD,CAHT;MAMLS,KAAK,EAAEV,QAAQ,CAAC;QACZC,IAAI,EAAE;MADM,CAAD;IANV,CAAP;EAUD,CAjBY;;EAkBbU,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CApBY;;EAqBbC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACThB,gBAAgB,CAAC,KAAKO,IAAN,EAAY,KAAKG,MAAjB,CAAhB,CAAyCQ,IAAzC,CAA+CC,GAAD,IAAS;QAAE,KAAKP,SAAL,GAAiBO,GAAjB;MAAqB,CAA9E;IACD,CAHM;;IAIPC,QAAQ,GAAE;MACP,KAAKV,MAAL,CAAYC,MAAZ;MACCX,gBAAgB,CAAC,KAAKO,IAAN,EAAY,KAAKG,MAAjB,CAAhB,CAAyCQ,IAAzC,CAA+CC,GAAD,IAAS;QAAE,KAAKP,SAAL,GAAiBO,GAAjB;MAAqB,CAA9E;IACH,CAPM;;IAQPE,QAAQ,GAAE;MACR,KAAKX,MAAL,CAAYC,MAAZ;MACAX,gBAAgB,CAAC,KAAKO,IAAN,EAAY,KAAKG,MAAjB,CAAhB,CAAyCQ,IAAzC,CAA+CC,GAAD,IAAS;QAAE,KAAKP,SAAL,GAAiBO,GAAjB;MAAqB,CAA9E;IACD,CAXM;;IAYP,MAAMG,YAAN,CAAmBC,GAAnB,EAAwB;MACtB,IAAIC,EAAC,GAAI,KAAKZ,SAAL,CAAea,IAAf,CAAoBF,GAApB,EAAyBC,EAAlC;;MACA,IAAI,MAAMtB,YAAY,CAACwB,OAAb,CAAqB,2CAArB,EACN,SADM,EAEN;QACEC,iBAAiB,EAAE,IADrB;QAEEC,gBAAgB,E