{"ast":null,"code":"import axios from \"axios\";\nimport { reactive } from \"vue\";\nexport default {\n  name: \"LoginPage\",\n\n  data() {\n    return {\n      params: reactive({\n        username: '',\n        password: '',\n        passwordConfirm: '123',\n        question: '123',\n        answer: '123'\n      })\n    };\n  },\n\n  methods: {\n    handle(name) {\n      this.$router.push({\n        name: name\n      });\n    },\n\n    async login() {\n      try {\n        await axios.get(\"/login\", {\n          params: this.params\n        });\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  }\n};","map":{"version":3,"mappings":"AA0BA,OAAOA,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AACA,eAAe;EACbC,IAAI,EAAE,WADO;;EAEbC,IAAI,GAAG;IACL,OAAO;MACLC,MAAM,EAAEH,QAAQ,CAAC;QACfI,QAAQ,EAAE,EADK;QAEfC,QAAQ,EAAE,EAFK;QAGfC,eAAe,EAAE,KAHF;QAIfC,QAAQ,EAAE,KAJK;QAKfC,MAAM,EAAE;MALO,CAAD;IADX,CAAP;EASD,CAZY;;EAabC,OAAO,EAAE;IACPC,MAAM,CAACT,IAAD,EAAO;MACX,KAAKU,OAAL,CAAaC,IAAb,CAAkB;QAACX,IAAI,EAAEA;MAAP,CAAlB;IACD,CAHM;;IAIP,MAAMY,KAAN,GAAc;MACZ,IAAI;QACF,MAAMd,KAAK,CAACe,GAAN,CAAU,QAAV,EAAoB;UAACX,MAAM,EAAE,KAAKA;QAAd,CAApB,CAAN;MACF,CAFA,CAEE,OAAOY,CAAP,EAAU;QACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;MACF;IACF;;EAVO;AAbI,CAAf","names":["axios","reactive","name","data","params","username","password","passwordConfirm","question","answer","methods","handle","$router","push","login","get","e","console","log"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\work\\bdbdbdbdbdbd\\1\\1lab\\frontend\\src\\components\\LoginPage.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>Login</h1>\n\n    <div class=\"createForm\">\n      <el-form :model=\"params\">\n        <el-form-item label=\"User Name\">\n          <el-input v-model=\"params.username\" />\n        </el-form-item>\n\n        <el-form-item label=\"Password\">\n          <el-input v-model=\"params.password\" />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button class=\"submit\" type=\"success\" round @click=\"login\">Login</el-button>\n          <el-button class=\"submit\" round @click=\"this.handle('Username Page')\">Don't remember a password?</el-button>\n\n        </el-form-item>\n      </el-form>\n    </div>\n\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport {reactive} from \"vue\";\nexport default {\n  name: \"LoginPage\",\n  data() {\n    return {\n      params: reactive({\n        username: '',\n        password: '',\n        passwordConfirm: '123',\n        question: '123',\n        answer: '123'\n      })\n    }\n  },\n  methods: {\n    handle(name) {\n      this.$router.push({name: name})\n    },\n    async login() {\n      try {\n        await axios.get(\"/login\", {params: this.params})\n      } catch (e) {\n        console.log(e);\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22a2e3;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}