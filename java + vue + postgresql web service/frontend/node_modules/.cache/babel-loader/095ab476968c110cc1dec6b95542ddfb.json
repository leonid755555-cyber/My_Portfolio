{"ast":null,"code":"import { getTableRecords1 } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive } from \"vue\";\nimport { ref } from \"vue\";\nimport { personIdParamOptions, postIdParamOptions } from \"@/data/parameters\";\nconst dialogFormVisible = ref(false);\nexport default {\n  name: \"EmplTable\",\n  props: {\n    link: String,\n    name: String,\n    listData: {\n      type: Array,\n      required: true\n    },\n    size: {\n      type: Number,\n      required: false,\n      default: 10\n    }\n  },\n\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        fio: '',\n        postId: {\n          id: ''\n        },\n        headId: ''\n      }),\n      form1: reactive({\n        fio: '',\n        postId: {\n          id: ''\n        },\n        headId: '',\n        id: ''\n      }),\n      pageNumber: 0,\n      dialogFormVisible\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords1(this.link, this.pageNumber).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    nextPage() {\n      this.pageNumber++;\n    },\n\n    prevPage() {\n      this.pageNumber--;\n    },\n\n    paginatedData() {\n      const start = this.pageNumber * this.size,\n            end = start + this.size;\n      return this.listData.slice(start, end);\n    },\n\n    pageCount() {\n      let l = this.listData.length,\n          s = this.size;\n      return Math.ceil(l / s);\n    },\n\n    async updateEntity() {\n      try {\n        const response = await axios.post(this.link, this.form1);\n        this.getTable();\n        this.allpersonIdOptions.push({\n          value: response.data.id,\n          label: response.data.fio\n        });\n        ElMessage({\n          type: 'success',\n          message: 'Successfully updated'\n        });\n      } catch (e) {\n        console.log(e);\n        ElMessage({\n          type: 'info',\n          message: 'Unsuccessfully updated'\n        });\n      }\n    },\n\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form);\n        this.getTable();\n        this.allpersonIdOptions.push({\n          value: response.data.id,\n          label: response.data.fio\n        });\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  },\n\n  setup() {\n    const allpersonIdOptions = ref(personIdParamOptions);\n    const allpostIdOptions = ref(postIdParamOptions);\n    return {\n      allpersonIdOptions,\n      allpostIdOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AAuFA,SAAQA,gBAAR,QAA+B,mBAA/B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AACA,SAAQC,GAAR,QAAkB,KAAlB;AACA,SAAQC,oBAAR,EAA8BC,kBAA9B,QAAuD,mBAAvD;AACA,MAAMC,iBAAgB,GAAIH,GAAG,CAAC,KAAD,CAA7B;AACA,eAAe;EACbI,IAAI,EAAE,WADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG,MAFD;IAGLC,QAAQ,EAAC;MACPC,IAAI,EAACC,KADE;MAEPC,QAAQ,EAAC;IAFF,CAHJ;IAOLC,IAAI,EAAC;MACHH,IAAI,EAACI,MADF;MAEHF,QAAQ,EAAC,KAFN;MAGHG,OAAO,EAAE;IAHN;EAPA,CAFM;;EAebC,IAAI,GAAG;IACL,OAAO;MACLC,SAAS,EAAE,EADN;MAELC,IAAI,EAAElB,QAAQ,CAAC;QACbmB,GAAG,EAAE,EADQ;QAEbC,MAAM,EAAE;UAACC,EAAE,EAA