{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive } from \"vue\";\nimport { ref } from \"vue\";\nimport { autoIdParamOptions, personIdParamOptions } from \"@/data/parameters\";\nexport default {\n  name: \"Repair_reportsTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        transportId: {\n          id: ''\n        },\n        emplId: {\n          id: ''\n        },\n        date_of_receipt: '',\n        completion_date: '',\n        cost: null,\n        work_type: ''\n      })\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    async createEntity() {\n      try {\n        await axios.post(this.link, this.form);\n        this.getTable();\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  },\n\n  setup() {\n    const allAutoIdOptions = ref(autoIdParamOptions);\n    const allEmplIdOptions = ref(personIdParamOptions);\n    return {\n      allAutoIdOptions,\n      allEmplIdOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AA2EA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AACA,SAAQC,GAAR,QAAkB,KAAlB;AACA,SAAQC,kBAAR,EAA4BC,oBAA5B,QAAuD,mBAAvD;AAEA,eAAe;EACbC,IAAI,EAAE,qBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,SAAS,EAAE,EADN;MAELC,IAAI,EAAEV,QAAQ,CAAC;QACbW,WAAW,EAAE;UAACC,EAAE,EAAC;QAAJ,CADA;QAEbC,MAAM,EAAE;UAACD,EAAE,EAAC;QAAJ,CAFK;QAGbE,eAAe,EAAE,EAHJ;QAIbC,eAAe,EAAE,EAJJ;QAKbC,IAAI,EAAE,IALO;QAMbC,SAAS,EAAE;MANE,CAAD;IAFT,CAAP;EAWD,CAlBY;;EAmBbC,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CArBY;;EAsBbC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACTvB,eAAe,CAAC,KAAKU,IAAN,EAAY,IAAZ,CAAf,CAAiCe,IAAjC,CAAuCC,GAAD,IAAS;QAAE,KAAKb,SAAL,GAAiBa,GAAjB;MAAqB,CAAtE;IACD,CAHM;;IAIP,MAAMC,YAAN,CAAmBC,GAAnB,EAAwB;MACtB,IAAIZ,EAAC,GAAI,KAAKH,SAAL,CAAegB,IAAf,CAAoBD,GAApB,EAAyBZ,EAAlC;;MACA,IAAI,MAAMd,YAAY,CAAC4B,OAAb,CAAqB,2CAArB,EACN,SADM,EAEN;QACEC,iBAAiB,EAAE,IADrB;QAEEC,gBAAgB,EAAE,QAFpB;QAGEC,IAAI,EAAE;MAHR,CAFM,CAAV,EAMQ;QACN,IAAI;UACF,MAAM9B,KAAK,CAAC+B,MAAN,CAAa,KAAKxB,IAAL,GAAY,GAAZ,GAAkBM,EAA/B,CAAN;UACA,KAAKH,SAAL,CAAegB,IAAf,CAAoBM,MAApB,CAA2BP,GAA3B,EAAgC,CAAhC;UACA3B,SAAS,CAAC;YACRgC,IAAI,EAAE,SADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF,CAPA,CAOE,OAAOC,CAAP,EAAU;UACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;UACApC,SAAS,CAAC;YACRgC,IAAI,EAAE,MADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF;MACF;IACD,CA5BM;;IA6BP,MAAMI,YAAN,GAAqB;MACnB,IAAI;QACF,MAAMrC,KAAK,CAACsC,IAAN,CAAW,KAAK/B,IAAhB,EAAsB,KAAKI,IAA3B,CAAN;QACA,KAAKS,QAAL;MACF,CAHA,CAGE,OAAOc,CAAP,EAAU;QACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;MACF;IACF;;EApCO,CAtBI;;EA4DbK,KAAK,GAAG;IACN,MAAMC,gBAAe,GAAItC,GAAG,CAACC,kBAAD,CAA5B;IACA,MAAMsC,gBAAe,GAAIvC,GAAG,CAACE,oBAAD,CAA5B;IACA,OAAO;MAACoC,gBAAD;MAAmBC;IAAnB,CAAP;EACF;;AAhEa,CAAf","names":["getTableRecords","ElMessage","ElMessageBox","axios","reactive","ref","autoIdParamOptions","personIdParamOptions","name","props","link","String","data","tableData","form","transportId","id","emplId","date_of_receipt","completion_date","cost","work_type","mounted","getTable","methods","then","ret","deleteEntity","idx","rows","confirm","confirmButtonText","cancelButtonText","type","delete","splice","message","e","console","log","createEntity","post","setup","allAutoIdOptions","allEmplIdOptions"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\bdbdbdbdbdbd\\1\\frontend\\src\\components\\Tables\\Repair_reportsTable.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n    <div class=\"createForm\">\n      <el-form :model=\"form\">\n\n        <el-form-item label=\"Auto Id\">\n          <div class=\"selectDropdown\">\n            <el-select-v2\n                v-model=\"form.transportId\"\n                :options=\"this.allAutoIdOptions\"\n                placeholder=\"Select Auto Id\"\n            />\n          </div>\n        </el-form-item>\n\n        <el-form-item label=\"Employe FIO\">\n          <div class=\"selectDropdown\">\n            <el-select-v2\n                v-model=\"this.form.emplId\"\n                :options=\"this.allEmplIdOptions\"\n                placeholder=\"Select FIO\"\n            />\n          </div>\n        </el-form-item>\n\n\n        <el-form-item label=\"Date Of Receipt\">\n          <div class=\"date\">\n            <el-date-picker v-model=\"this.form.date_of_receipt\"\n                          type=\"date\"\n                          placeholder=\"Pick Date Of Receipt\"\n                          format=\"YYYY/MM/DD\"\n                          value-format=\"YYYY-MM-DD\"/>\n          </div>\n        </el-form-item>\n\n        <el-form-item label=\"Completion Date\">\n          <div class=\"date\">\n            <el-date-picker v-model=\"this.form.completion_date\"\n                          type=\"date\"\n                          placeholder=\"Pick Completion Date\"\n                          format=\"YYYY/MM/DD\"\n                          value-format=\"YYYY-MM-DD\"/>\n          </div>\n        </el-form-item>\n\n        <el-form-item label=\"Cost\">\n          <el-input v-model=\"form.cost\" />\n        </el-form-item>\n\n        <el-form-item label=\"Work Type\">\n          <el-input v-model=\"form.work_type\" />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button class=\"submit\" type=\"success\" round @click=\"createEntity\">Create</el-button>\n\n        </el-form-item>\n      </el-form>\n    </div>\n\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n      <el-table-column label=\"Delete Record\">\n        <template #default=\"scope\">\n          <el-button type=\"danger\" round  v-on:click=\"deleteEntity(scope.$index)\">Delete</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {ElMessage, ElMessageBox} from \"element-plus\";\nimport axios from \"axios\";\nimport {reactive} from \"vue\";\nimport {ref} from \"vue\";\nimport {autoIdParamOptions, personIdParamOptions} from \"@/data/parameters\";\n\nexport default {\n  name: \"Repair_reportsTable\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        transportId: {id:''},\n        emplId: {id:''},\n        date_of_receipt: '',\n        completion_date: '',\n        cost: null,\n        work_type: '' \n      })\n    }\n  },\n  mounted() {\n    this.getTable()\n  },\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then((ret) => { this.tableData = ret})\n    },\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\",\n          'Warning',\n          {\n            confirmButtonText: 'OK',\n            cancelButtonText: 'Cancel',\n            type: 'warning',\n          })) {\n        try {\n          await axios.delete(this.link + \"/\" + id)\n          this.tableData.rows.splice(idx, 1)\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted',\n          })\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted',\n          });\n        }\n      }\n    },\n    async createEntity() {\n      try {\n        await axios.post(this.link, this.form)\n        this.getTable()\n      } catch (e) {\n        console.log(e);\n      }\n    }\n  },\n  setup() {\n    const allAutoIdOptions = ref(autoIdParamOptions)\n    const allEmplIdOptions = ref(personIdParamOptions)\n    return {allAutoIdOptions, allEmplIdOptions}\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22a2e3;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}