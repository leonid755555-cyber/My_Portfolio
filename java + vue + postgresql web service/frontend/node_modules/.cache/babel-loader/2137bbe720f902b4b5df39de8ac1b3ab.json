{"ast":null,"code":"import { getTableRecords1, toCapitalizedWords } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive } from \"vue\";\nimport { ref } from \"vue\";\nimport { personIdParamOptions, postIdParamOptions } from \"@/data/parameters\";\nconst dialogFormVisible = ref(false);\nexport default {\n  name: \"EmplTable\",\n  props: {\n    link: String,\n    name: String,\n    listData: {\n      type: Array,\n      required: true\n    },\n    size: {\n      type: Number,\n      required: false,\n      default: 10\n    }\n  },\n\n  data() {\n    return {\n      params: {\n        offset: 0\n      },\n      tableData: {},\n      form: reactive({\n        fio: '',\n        postId: {\n          id: ''\n        },\n        headId: ''\n      }),\n      form1: reactive({\n        fio: '',\n        postId: {\n          id: ''\n        },\n        headId: '',\n        id: ''\n      }),\n      dialogFormVisible,\n      totalPages: 0\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    async getTable() {\n      try {\n        const response = await axios.get(this.link, {\n          params: this.params\n        });\n        let rows = response.data.content;\n        let columns = [];\n        totalPages = response.data.content.totalPages;\n\n        for (const key in rows[0]) {\n          let obj = {\n            field: key,\n            headerName: toCapitalizedWords(key)\n          };\n          columns.push(obj);\n        }\n\n        this.tableData = {\n          columns,\n          rows\n        };\n      } catch (e) {\n        console.log(e);\n      }\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    nextPage() {\n      this.params.offset++;\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    prevPage() {\n      this.params.offset--;\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    paginatedData() {\n      const start = this.pageNumber * this.size,\n            end = start + this.size;\n      return this.listData.slice(start, end);\n    },\n\n    pageCount() {\n      let l = this.listData.length,\n          s = this.size;\n      return Math.ceil(l / s);\n    },\n\n    async updateEntity() {\n      try {\n        const response = await axios.post(this.link, this.form1);\n        this.getTable();\n        this.allpersonIdOptions.push({\n          value: response.data.id,\n          label: response.data.fio\n        });\n        ElMessage({\n          type: 'success',\n          message: 'Successfully updated'\n        });\n      } catch (e) {\n        console.log(e);\n        ElMessage({\n          type: 'info',\n          message: 'Unsuccessfully updated'\n        });\n      }\n    },\n\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form);\n        this.getTable();\n        this.allpersonIdOptions.push({\n          value: response.data.id,\n          label: response.data.fio\n        });\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  },\n\n  setup() {\n    const allpersonIdOptions = ref(personIdParamOptions);\n    const allpostIdOptions = ref(postIdParamOptions);\n    return {\n      allpersonIdOptions,\n      allpostIdOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AAuFA,SAAQA,gBAAR,EAA0BC,kBAA1B,QAAmD,mBAAnD;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AACA,SAAQC,GAAR,QAAkB,KAAlB;AACA,SAAQC,oBAAR,EAA8BC,kBAA9B,QAAuD,mBAAvD;AACA,MAAMC,iBAAgB,GAAIH,GAAG,CAAC,KAAD,CAA7B;AACA,eAAe;EACbI,IAAI,EAAE,WADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG,MAFD;IAGLC,QAAQ,EAAC;MACPC,IAAI,EAACC,KADE;MAEPC,QAAQ,EAAC;IAFF,CAHJ;IAOLC,IAAI,EAAC;MACHH,IAAI,EAACI,MADF;MAEHF,QAAQ,EAAC,KAFN;MAGHG,OAAO,EAAE;IAHN;EAPA,CAFM;;EAebC,IAAI,GAAG;IACL,OAAO;MACLC,MAAM,EAAE;QAACC,MAAM,EAAE;MAAT,CADH;MAELC,SAAS,EAAE,EAFN;MAGLC,IAAI,EAAEpB,QAAQ,CAAC;QACbqB,GAAG,EAAE,EADQ;QAEbC,MAAM,EAAE;UAACC,EAAE,EAAC;QAAJ,CAFK;QAGbC,MAAM,EAAE;MAHK,CAAD,CAHT;MAQLC,KAAK,EAAEzB,QAAQ,CAAC;QACdqB,GAAG,EAAE,EADS;QAEdC,MAAM,EAAE;UAACC,EAAE,EAAC;QAAJ,CAFM;QAGdC,MAAM,EAAE,EAHM;QAIdD,EAAE,EAAE;MAJU,CAAD,CARV;MAcLnB,iBAdK;MAeLsB,UAAU,EAAE;IAfP,CAAP;EAiBD,CAjCY;;EAkCbC,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CApCY;;EAqCbC,OAAO,EAAE;IACP,MAAMD,QAAN,GAAiB;MACjB,IAAI;QACA,MAAME,QAAO,GAAI,MAAM/B,KAAK,CAACgC,GAAN,CAAU,KAAKxB,IAAf,EAAqB;UAACU,MAAM,EAAE,KAAKA;QAAd,CAArB,CAAvB;QACA,IAAIe,IAAG,GAAIF,QAAQ,CAACd,IAAT,CAAciB,OAAzB;QACA,IAAIC,OAAM,GAAI,EAAd;QACAR,UAAS,GAAII,QAAQ,CAACd,IAAT,CAAciB,OAAd,CAAsBP,UAAnC;;QACA,KAAK,MAAMS,GAAX,IAAkBH,IAAI,CAAC,CAAD,CAAtB,EAA2B;UACvB,IAAII,GAAE,GAAI;YAACC,KAAK,EAAEF,GAAR;YAAaG,UAAU,EAAE1C,kBAAkB,CAACuC,GAAD;UAA3C,CAAV;UACAD,OAAO,CAACK,IAAR,CAAaH,GAAb;QACJ;;QACA,KAAKjB,SAAL,GAAiB;UAACe,OAAD;UAAUF;QAAV,CAAjB;MACJ,CAVA,CAUE,OAAOQ,CAAP,EAAU;QACRC,OAAO,CAACC,GAAR,CAAYF,CAAZ;MACH;IAAC,CAdK;;IAeP,MAAMG,YAAN,CAAmBC,GAAnB,EAAwB;MACtB,IAAIrB,EAAC,GAAI,KAAKJ,SAAL,CAAea,IAAf,CAAoBY,GAApB,EAAyBrB,EAAlC;;MACA,IAAI,MAAMzB,YAAY,CAAC+C,OAAb,CAAqB,2CAArB,EACN,SADM,EAEN;QACEC,iBAAiB,EAAE,IADrB;QAEEC,gBAAgB,EAAE,QAFpB;QAGErC,IAAI,EAAE;MAHR,CAFM,CAAV,EAMQ;QACN,IAAI;UACF,MAAMX,KAAK,CAACiD,MAAN,CAAa,KAAKzC,IAA