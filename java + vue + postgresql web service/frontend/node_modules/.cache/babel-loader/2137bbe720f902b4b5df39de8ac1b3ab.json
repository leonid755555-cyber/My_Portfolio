kBAAD,CAA5B;IACA,OAAO;MAACiE,kBAAD;MAAqBK;IAArB,CAAP;EACF;;AApIa,CAAf","names":["getTableRecords1","toCapitalizedWords","ElMessage","ElMessageBox","axios","reactive","ref","personIdParamOptions","postIdParamOptions","dialogFormVisible","name","props","link","String","listData","type","Array","required","size","Number","default","data","params","offset","tableData","form","fio","postId","id","headId","form1","totalPages","mounted","getTable","methods","response","get","rows","content","columns","key","obj","field","headerName","push","e","console","log","deleteEntity","idx","confirm","confirmButtonText","cancelButtonText","delete","splice","message","nextPage","then","ret","prevPage","paginatedData","start","pageNumber","end","slice","pageCount","l","length","s","Math","ceil","updateEntity","post","allpersonIdOptions","value","label","createEntity","setup","allpostIdOptions"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\work\\bdbdbdbdbdbd\\1\\1lab\\frontend\\src\\components\\Tables\\EmplTable.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n\n    <div class=\"createForm\">\n      <el-form :model=\"form\">\n        <el-form-item label=\"Employer FIO\">\n          <el-input v-model=\"form.fio\" />\n        </el-form-item>\n\n        <el-form-item label=\"Employer Post\">\n          <el-select-v2\n              class=\"selectDropdown\"\n              v-model=\"form.postId\"\n              :options=\"this.allpostIdOptions\"\n              placeholder=\"Select Post\"\n          />\n        </el-form-item>\n\n        <el-form-item label=\"Employer HeadId\">\n          <el-input v-model=\"form.headId\" />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button class=\"submit\" type=\"success\" round @click=\"createEntity\">Create</el-button>\n\n        </el-form-item>\n      </el-form>\n    </div>\n\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n      <el-table-column label=\"Delete Record\">\n        <template #default=\"scope\">\n          <el-button type=\"danger\" round  v-on:click=\"deleteEntity(scope.$index)\">Delete</el-button>\n        </template>\n      </el-table-column>\n        <el-table-column label=\"Update Record\">\n          <el-button type=\"warning\" round  @click=\"dialogFormVisible = true\">Update</el-button>\n      </el-table-column>\n    </el-table>\n\n      <el-dialog v-model=\"dialogFormVisible\" title=\"Update\">\n        <el-form :model=\"form1\">\n\n          <el-form-item label=\"Id\">\n            <el-input v-model=\"form1.id\" />\n          </el-form-item>\n\n          <el-form-item label=\"Employer FIO\">\n            <el-input v-model=\"form1.fio\" />\n          </el-form-item>\n\n          <el-form-item label=\"Employer Post\">\n            <el-select-v2\n                class=\"selectDropdown\"\n                v-model=\"form1.postId\"\n                :options=\"this.allpostIdOptions\"\n                placeholder=\"Select Post\"\n            />\n          </el-form-item>\n\n          <el-form-item label=\"Employer HeadId\">\n            <el-input v-model=\"form1.headId\" />\n          </el-form-item>\n        </el-form>\n      <template #footer>\n        <span class=\"dialog-footer\">\n          <el-button @click=\"dialogFormVisible = false\">Cancel</el-button>\n          <el-button type=\"primary\" @click=\"updateEntity(); dialogFormVisible = false;\">Confirm</el-button>\n        </span>\n      </template>\n    </el-dialog>\n  </div>\n\n  <div>\n  <button v-if=\"this.params.offset > 0\" @click=\"prevPage\">\n    Previous\n  </button>\n  <button v-if=\"this.params.offset < this.tableData.totalPages\" @click=\"nextPage\">\n    Next\n  </button>\n</div>\n</template>\n\n<script>\nimport {getTableRecords1, toCapitalizedWords} from \"@/getTableRecords\";\nimport {ElMessage, ElMessageBox} from \"element-plus\";\nimport axios from \"axios\";\nimport {reactive} from \"vue\";\nimport {ref} from \"vue\";\nimport {personIdParamOptions, postIdParamOptions} from \"@/data/parameters\";\nconst dialogFormVisible = ref(false)\nexport default {\n  name: \"EmplTable\",\n  props: {\n    link: String,\n    name: String,\n    listData:{\n      type:Array,\n      required:true\n    },\n    size:{\n      type:Number,\n      required:false,\n      default: 10\n    }\n  },\n  data() {\n    return {\n      params: {offset: 0},\n      tableData: {},\n      form: reactive({\n        fio: '',\n        postId: {id:''},\n        headId: ''\n      }),\n      form1: reactive({\n        fio: '',\n        postId: {id:''},\n        headId: '',\n        id: ''\n      }),\n      dialogFormVisible,\n      totalPages: 0\n    }\n  },\n  mounted() {\n    this.getTable()\n  },\n  methods: {\n    async getTable() {      \n    try {\n        const response = await axios.get(this.link, {params: this.params})\n        let rows = response.data.content\n        let columns = []\n        totalPages = response.data.content.totalPages\n        for (const key in rows[0]) {\n            let obj = {field: key, headerName: toCapitalizedWords(key)}\n            columns.push(obj);\n        }\n        this.tableData = {columns, rows}\n    } catch (e) {\n        console.log(e);\n    }},\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\",\n          'Warning',\n          {\n            confirmButtonText: 'OK',\n            cancelButtonText: 'Cancel',\n            type: 'warning',\n          })) {\n        try {\n          await axios.delete(this.link + \"/\" + id)\n          this.tableData.rows.splice(idx, 1)\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted',\n          })\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted',\n          });\n        }\n      }\n    },\n    nextPage(){\n       this.params.offset++;\n        getTableRecords1(this.link, this.params).then((ret) => { this.tableData = ret})\n    },\n    prevPage(){\n      this.params.offset--;\n      getTableRecords1(this.link, this.params).then((ret) => { this.tableData = ret})\n    },  \n    paginatedData(){\n    const start = this.pageNumber * this.size,\n          end = start + this.size;\n    return this.listData.slice(start, end);\n    },\n    pageCount(){\n      let l = this.listData.length,\n          s = this.size;\n      return Math.ceil(l/s);\n    },\n    async updateEntity() {\n        try {\n          const response = await axios.post(this.link, this.form1)\n          this.getTable()\n          this.allpersonIdOptions.push({\n          value: response.data.id,\n          label: response.data.fio,\n        })\n          ElMessage({\n            type: 'success',\n            message: 'Successfully updated',\n          })\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully updated',\n          });\n        }\n    },\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form)\n        this.getTable()\n        this.allpersonIdOptions.push({\n          value: response.data.id,\n          label: response.data.fio,\n        })\n      } catch (e) {\n        console.log(e);\n      }\n    }\n  },\n  setup() {\n    const allpersonIdOptions = ref(personIdParamOptions)\n    const allpostIdOptions = ref(postIdParamOptions)\n    return {allpersonIdOptions, allpostIdOptions}\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22a2e3;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}