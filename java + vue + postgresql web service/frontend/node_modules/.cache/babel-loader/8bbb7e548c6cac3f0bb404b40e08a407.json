{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { brigadeIdParamOptions, objectIdParamOptions } from \"@/data/parameters\";\nimport { ref } from \"vue\";\nexport default {\n  name: \"WorkTypeByBrigadeInPeriodListQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        brigadeIdParam: null,\n        startDateParam: null,\n        endDateParam: null,\n        objectIdParam: null\n      },\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.updateData();\n  },\n\n  methods: {\n    updateData() {\n      console.log(this.params.startDateParam);\n      console.log(this.params.endDateParam);\n      getTableRecords(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    }\n\n  },\n\n  setup() {\n    const allBrigadeOptions = ref(brigadeIdParamOptions);\n    const allObjectOptions = ref(objectIdParamOptions);\n    return {\n      allBrigadeOptions,\n      allObjectOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AA6CA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,qBAAR,EAA+BC,oBAA/B,QAA0D,mBAA1D;AACA,SAAQC,GAAR,QAAkB,KAAlB;AAEA,eAAe;EACbC,IAAI,EAAE,oCADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,MAAM,EAAE;QACNC,cAAc,EAAE,IADV;QAENC,cAAc,EAAE,IAFV;QAGNC,YAAY,EAAE,IAHR;QAINC,aAAa,EAAE;MAJT,CADH;MAOLC,SAAS,EAAE;IAPN,CAAP;EAQD,CAfY;;EAgBbC,OAAO,GAAG;IACR,KAAKC,UAAL;EACD,CAlBY;;EAmBbC,OAAO,EAAE;IACPD,UAAU,GAAG;MACXE,OAAO,CAACC,GAAR,CAAY,KAAKV,MAAL,CAAYE,cAAxB;MACAO,OAAO,CAACC,GAAR,CAAY,KAAKV,MAAL,CAAYG,YAAxB;MACAZ,eAAe,CAAC,KAAKM,IAAN,EAAY,KAAKG,MAAjB,CAAf,CAAwCW,IAAxC,CAA8CC,GAAD,IAAS;QAAE,KAAKP,SAAL,GAAiBO,GAAjB;MAAqB,CAA7E;IACF;;EALO,CAnBI;;EA0BbC,KAAK,GAAG;IACN,MAAMC,iBAAgB,GAAIpB,GAAG,CAACF,qBAAD,CAA7B;IACA,MAAMuB,gBAAe,GAAIrB,GAAG,CAACD,oBAAD,CAA5B;IACA,OAAO;MAACqB,iBAAD;MAAoBC;IAApB,CAAP;EACF;;AA9Ba,CAAf","names":["getTableRecords","brigadeIdParamOptions","objectIdParamOptions","ref","n