{"ast":null,"code":"import axios from \"axios\";\nimport { reactive } from \"vue\";\nimport { ref } from \"vue\";\nimport { ElMessage } from \"element-plus\";\nconst dialogFormVisible = ref(false);\nexport default {\n  name: \"UserName\",\n\n  data() {\n    return {\n      form: reactive({\n        username: '',\n        password: '',\n        passwordConfirm: '',\n        question: 321,\n        answer: ''\n      }),\n      dialogFormVisible,\n      new: []\n    };\n  },\n\n  methods: {\n    async tryUser() {\n      try {\n        const response = await axios.get(\"/username/\" + this.form.username);\n        this.new = response.data.question;\n        ElMessage({\n          type: 'info',\n          message: '{{ this.form.username }}'\n        });\n      } catch (e) {\n        console.log(e);\n        ElMessage({\n          type: 'info',\n          message: 'Wrong username'\n        });\n      }\n    }\n\n  }\n};","map":{"version":3,"mappings":"AAoCA,OAAOA,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AACA,SAAQC,GAAR,QAAkB,KAAlB;AACA,SAAQC,SAAR,QAAwB,cAAxB;AACA,MAAMC,iBAAgB,GAAIF,GAAG,CAAC,KAAD,CAA7B;AACA,eAAe;EACbG,IAAI,EAAE,UADO;;EAEbC,IAAI,GAAG;IACL,OAAO;MACLC,IAAI,EAAEN,QAAQ,CAAC;QACbO,QAAQ,EAAE,EADG;QAEbC,QAAQ,EAAE,EAFG;QAGbC,eAAe,EAAE,EAHJ;QAIbC,QAAQ,EAAE,GAJG;QAKbC,MAAM,EAAE;MALK,CAAD,CADT;MAQLR,iBARK;MASLS,GAAG,EAAC;IATC,CAAP;EAWD,CAdY;;EAebC,OAAO,EAAE;IACP,MAAMC,OAAN,GAAgB;MACd,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMhB,KAAK,CAACiB,GAAN,CAAU,eAAe,KAAKV,IAAL,CAAUC,QAAnC,CAAvB;QACA,KAAKK,GAAL,GAAWG,QAAQ,CAACV,IAAT,CAAcK,QAAzB;QACAR,SAAS,CAAC;UACNe,IAAI,EAAE,MADA;UAENC,OAAO,EAAE;QAFH,CAAD,CAAT;MAKF,CARA,CASC,OAAOC,CAAP,EAAU;QACTC,OAAO,CAACC,GAAR,CAAYF,CAAZ;QACAjB,SAAS,CAAC;UACNe,IAAI,EAAE,MADA;UAENC,OAAO,EAAE;QAFH,CAAD,CAAT;MAKF;IACF;;EAnBO;AAfI,CAAf","names":["axios","reactive","ref","ElMessage","dialogFormVisible","name","data","form","username","password","passwordConfirm","question","answer","new","methods","tryUser","response","get","type","message","e","console","log"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\work\\bdbdbdbdbdbd\\1\\1lab\\frontend\\src\\components\\UserNamePage.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>Enter your Username</h1>\n\n    <div class=\"createForm\">\n      <el-form :model=\"form\">\n        <el-form-item label=\"User Name\">\n          <el-input v-model=\"form.username\" />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button class=\"submit\" type=\"success\" round @click=\"tryUser(); dialogFormVisible = true;\">Continue</el-button>\n\n        </el-form-item>\n      </el-form>\n    </div>\n\n<el-dialog v-model=\"dialogFormVisible\" title= {{ this.form.username }}> \n   <h1>{{ this.new }}</h1>\n        <el-form :model=\"form\">\n          <el-form-item label=\"Answer\">\n            <el-input v-model=\"form.answer\" />\n          </el-form-item>\n      </el-form>\n           <template #footer>\n        <span class=\"dialog-footer\">\n          <el-button @click=\"dialogFormVisible = false\">Cancel</el-button>\n          <el-button type=\"primary\" @click=\"updateEntity(); dialogFormVisible = false;\">Confirm</el-button>\n        </span>\n      </template>\n    </el-dialog>\n\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport {reactive} from \"vue\";\nimport {ref} from \"vue\";\nimport {ElMessage} from \"element-plus\";\nconst dialogFormVisible = ref(false);\nexport default {\n  name: \"UserName\",\n  data() {\n    return {\n      form: reactive({\n        username: '',\n        password: '',\n        passwordConfirm: '',\n        question: 321,\n        answer: ''\n      }),\n      dialogFormVisible,\n      new:[]\n    }\n  },\n  methods: {\n    async tryUser() {\n      try {\n        const response = await axios.get(\"/username/\" + this.form.username);\n        this.new = response.data.question; \n        ElMessage({\n            type: 'info',\n            message: '{{ this.form.username }}',\n         \n        })\n      }\n       catch (e) {\n        console.log(e); \n        ElMessage({\n            type: 'info',\n            message: 'Wrong username',\n         \n        })\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22a2e3;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}