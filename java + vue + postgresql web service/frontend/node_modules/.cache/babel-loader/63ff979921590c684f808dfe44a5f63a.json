rm1.id\" />\n          </el-form-item>\n\n        <el-form-item label=\"Type name\">\n          <el-select-v2\n                class=\"selectDropdown\"\n                v-model=\"form1.typeId\"\n                :options=\"this.allTypeNameOptions\"\n                placeholder=\"Select Type\"\n          />\n        </el-form-item>\n\n        <el-form-item label=\"Place name\">\n          <el-select-v2\n              class=\"selectDropdown\"\n              v-model=\"form1.placeId\"\n              :options=\"this.allplaceIdOptions\"\n              placeholder=\"Select Place\"\n          />\n        </el-form-item>\n\n        <el-form-item label=\"Date Of Purchase\">\n          <div class=\"date\">\n            <el-date-picker v-model=\"this.form1.dt1\"\n                          type=\"date\"\n                          placeholder=\"Pick Date Of Purchase\"\n                          format=\"YYYY/MM/DD\"\n                          value-format=\"YYYY-MM-DD\"/>\n          </div>\n        </el-form-item>\n\n        <el-form-item label=\"End Of Life\">\n          <div class=\"date\">\n            <el-date-picker v-model=\"this.form1.working_life\"\n                          type=\"date\"\n                          placeholder=\"Pick End-Of-Life Date\"\n                          format=\"YYYY/MM/DD\"\n                          value-format=\"YYYY-MM-DD\"/>\n          </div>\n        </el-form-item>\n      </el-form>\n           <template #footer>\n        <span class=\"dialog-footer\">\n          <el-button @click=\"dialogFormVisible = false\">Cancel</el-button>\n          <el-button type=\"primary\" @click=\"updateEntity(); dialogFormVisible = false;\">Confirm</el-button>\n        </span>\n      </template>\n    </el-dialog>\n\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport {reactive} from \"vue\";\nimport {ref} from \"vue\";\nconst dialogFormVisible = ref(false);\nexport default {\n  name: \"UserName\",\n  data() {\n    return {\n      form: reactive({\n        username: ''\n      }),\n      dialogFormVisible\n    }\n  },\n  methods: {\n    async tryUser() {\n      try {\n        const responce = await axios.get(\"/username/\" + this.form.username)\n        dialogFormVisible = true;\n      } catch (e) {\n        console.log(e);\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22a2e3;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}