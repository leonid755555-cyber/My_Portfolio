{"ast":null,"code":"export default {\n  data() {\n    return {\n      username: '',\n      password: '',\n      alert: false\n    };\n  },\n\n  computed: {\n    error() {\n      return this.$store.getters.getError;\n    },\n\n    loading() {\n      return this.$store.getters.getLoading;\n    }\n\n  },\n  watch: {\n    error(value) {\n      if (value) {\n        this.alert = true;\n      }\n    },\n\n    alert(value) {\n      if (!value) {\n        this.$store.dispatch('setError', false);\n      }\n    }\n\n  },\n  methods: {\n    userSignIn() {\n      this.$store.dispatch('userSignIn', {\n        username: this.username,\n        password: this.password\n      });\n    }\n\n  }\n};","map":{"version":3,"mappings":"AAyCE,eAAe;EACbA,IAAI,GAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EADL;MAELC,QAAQ,EAAE,EAFL;MAGLC,KAAK,EAAE;IAHF,CAAP;EAKD,CAPY;;EAQbC,QAAQ,EAAE;IACRC,KAAK,GAAG;MACN,OAAO,KAAKC,MAAL,CAAYC,OAAZ,CAAoBC,QAA3B;IACD,CAHO;;IAIRC,OAAO,GAAG;MACR,OAAO,KAAKH,MAAL,CAAYC,OAAZ,CAAoBG,UAA3B;IACF;;EANQ,CARG;EAgBbC,KAAK,EAAE;IACLN,KAAK,CAACO,KAAD,EAAQ;MACX,IAAIA,KAAJ,EAAW;QACT,KAAKT,KAAL,GAAa,IAAb;MACF;IACD,CALI;;IAMLA,KAAK,CAACS,KAAD,EAAQ;MACX,IAAI,CAACA,KAAL,EAAY;QACV,KAAKN,MAAL,CAAYO,QAAZ,CAAqB,UAArB,EAAiC,KAAjC;MACF;IACF;;EAVK,CAhBM;EA4BbC,OAAO,EAAE;IACPC,UAAU,GAAG;MACX,KAAKT,MAAL,CAAYO,QAAZ,CAAqB,YAArB,EAAmC;QAACZ,QAAQ,EAAE,KAAKA,QAAhB;QAA0BC,QAAQ,EAAE,KAAKA;MAAzC,CAAnC;IACF;;EAHO;AA5BI,CAAf","names":["data","username","password","alert","computed","error","$store","getters","getError","loading","getLoading","watch","value","dispatch","methods","userSignIn"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\work\\bdbdbdbdbdbd\\1\\1lab\\frontend\\src\\components\\LoginPage.vue"],"sourcesContent":["<template>\n  <v-layout column>\n    <v-flex xs12 class=\"text-xs-center\" mt-5>\n      <h3>ВХОД</h3>\n    </v-flex>\n    <v-flex xs12 sm6 offset-sm3 mt-3>\n      <form @submit.prevent=\"userSignIn\">\n        <v-layout column>\n          <v-flex>\n            <v-alert error dismiss