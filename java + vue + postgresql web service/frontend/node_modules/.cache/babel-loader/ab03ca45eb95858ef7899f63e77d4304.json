{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive, ref } from \"vue\";\nimport { employerIdParamOptions, organisationIdParamOptions } from \"@/data/parameters\";\nexport default {\n  name: \"ContractTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        organisation: {\n          id: ''\n        },\n        employer: {\n          id: ''\n        }\n      })\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form);\n        this.getTable();\n        this.allObjectOptions.push({\n          value: response.data.id,\n          label: response.data.name\n        });\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  },\n\n  setup() {\n    const allEmployerOptions = ref(employerIdParamOptions);\n    const allOrganisationOptions = ref(organisationIdParamOptions);\n    return {\n      allEmployerOptions,\n      allOrganisationOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AA6CA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,EAAkBC,GAAlB,QAA4B,KAA5B;AACA,SACEC,sBADF,EAEEC,0BAFF,QAGO,mBAHP;AAKA,eAAe;EACbC,IAAI,EAAE,eADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,SAAS,EAAE,EADN;MAELC,IAAI,EAAEV,QAAQ,CAAC;QACbW,YAAY,EAAE;UAACC,EAAE,EAAE;QAAL,CADD;QAEbC,QAAQ,EAAE;UAACD,EAAE,EAAE;QAAL;MAFG,CAAD;IAFT,CAAP;EAOD,CAdY;;EAebE,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CAjBY;;EAkBbC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACTnB,eAAe,CAAC,KAAKU,IAAN,EAAY,IAAZ,CAAf,CAAiCW,IAAjC,CAAuCC,GAAD,IAAS;QAAE,KAAKT,SAAL,GAAiBS,GAAjB;MAAqB,CAAtE;IACD,CAHM;;IAIP,MAAMC,YAAN,CAAmBC,GAAnB,EAAwB;MACtB,IAAIR,EAAC,GAAI,KAAKH,SAAL,CAAeY,IAAf,CAAoBD,GAApB,EAAyBR,EAAlC;;MACA,IAAI,MAAMd,YAAY,CAACwB,OAAb,CAAqB,2CAArB,EACN,SADM,EAEN;QACEC,iBAAiB,EAAE,IADrB;QAEEC,gBAAgB,EAAE,QAFpB;QAGEC,IAAI,EAAE;MAHR,CAFM,CAAV,EAMQ;QACN,IAAI;UACF,MAAM1B,KAAK,CAAC2B,MAAN,CAAa,KAAKpB,IAAL,GAAY,GAAZ,GAAkBM,EAA/B,CAAN;UACA,KAAKH,SAAL,CAAeY,IAAf,CAAoBM,MAApB,CAA2BP,GAA3B,EAAgC,CAAhC;UACAvB,SAAS,CAAC;YACR4B,IAAI,EAAE,SADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF,CAPA,CAOE,OAAOC,CAAP,EAAU;UACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;UACAhC,SAAS,CAAC;YACR4B,IAAI,EAAE,MADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF;MACF;IACD,CA5BM;;IA6BP,MAAMI,YAAN,GAAqB;MACnB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMlC,KAAK,CAACmC,IAAN,CAAW,KAAK5B,IAAhB,EAAsB,KAAKI,IAA3B,CAAvB;QACA,KAAKK,QAAL;QACA,KAAKoB,gBAAL,CAAsBC,IAAtB,CAA2B;UACzBC,KAAK,EAAEJ,QAAQ,CAACzB,IAAT,CAAcI,EADI;UAEzB0B,KAAK,EAAEL,QAAQ,CAACzB,IAAT,CAAcJ;QAFI,CAA3B;MAIF,CAPA,CAOE,OAAOyB,CAAP,EAAU;QACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;MACF;IACF;;EAxCO,CAlBI;;EA4DbU,KAAK,GAAG;IACN,MAAMC,kBAAiB,GAAIvC,GAAG,CAACC,sBAAD,CAA9B;IACA,MAAMuC,sBAAqB,GAAIxC,GAAG,CAACE,0BAAD,CAAlC;IACA,OAAO;MAACqC,kBAAD;MAAoBC;IAApB,CAAP;EACF;;AAhEa,CAAf","names":["getTableRecords","ElMessage","ElMessageBox","axios","reactive","ref","employerIdParamOptions","organisationIdParamOptions","name","props","link","String","data","tableData","form","organisation","id","employer","mounted","getTable","methods","then","ret","deleteEntity","idx","rows","confirm","confirmButtonText","cancelButtonText","type","delete","splice","message","e","console","log","createEntity","response","post","allObjectOptions","push","value","label","setup","allEmployerOptions","allOrganisationOptions"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\bdbdbdbdbdbd\\1\\frontend\\src\\components\\Tables\\ContractTable.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n\n    <div class=\"createForm\">\n      <el-form :model=\"form\">\n\n        <el-form-item label=\"Employer name\">\n          <el-select-v2\n              class=\"selectDropdown\"\n              v-model=\"form.employer.id\"\n              :options=\"this.allEmployerOptions\"\n              placeholder=\"Select Employer\"\n          />\n        </el-form-item>\n\n        <el-form-item label=\"Organisation name\">\n          <el-select-v2\n              class=\"selectDropdown\"\n              v-model=\"form.organisation.id\"\n              :options=\"this.allOrganisationOptions\"\n              placeholder=\"Select Organisation\"\n          />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button class=\"submit\" type=\"success\" round @click=\"createEntity\">Create</el-button>\n\n        </el-form-item>\n      </el-form>\n    </div>\n\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n      <el-table-column label=\"Delete Record\">\n        <template #default=\"scope\">\n          <el-button type=\"danger\" round  v-on:click=\"deleteEntity(scope.$index)\">Delete</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {ElMessage, ElMessageBox} from \"element-plus\";\nimport axios from \"axios\";\nimport {reactive, ref} from \"vue\";\nimport {\n  employerIdParamOptions,\n  organisationIdParamOptions\n} from \"@/data/parameters\";\n\nexport default {\n  name: \"ContractTable\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        organisation: {id: ''},\n        employer: {id: ''}\n      })\n    }\n  },\n  mounted() {\n    this.getTable()\n  },\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then((ret) => { this.tableData = ret})\n    },\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\",\n          'Warning',\n          {\n            confirmButtonText: 'OK',\n            cancelButtonText: 'Cancel',\n            type: 'warning',\n          })) {\n        try {\n          await axios.delete(this.link + \"/\" + id)\n          this.tableData.rows.splice(idx, 1)\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted',\n          })\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted',\n          });\n        }\n      }\n    },\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form)\n        this.getTable()\n        this.allObjectOptions.push({\n          value: response.data.id,\n          label: response.data.name,\n        })\n      } catch (e) {\n        console.log(e);\n      }\n    }\n  },\n  setup() {\n    const allEmployerOptions = ref(employerIdParamOptions)\n    const allOrganisationOptions = ref(organisationIdParamOptions)\n    return {allEmployerOptions,allOrganisationOptions }\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22c0c2;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}