{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { autoIdParamOptions } from \"@/data/parameters\";\nimport { ref } from \"vue\";\nexport default {\n  name: \"DriverListQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        autoIdParam: null\n      },\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.updateData();\n  },\n\n  methods: {\n    updateData() {\n      getTableRecords(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    }\n\n  },\n\n  setup() {\n    const allAutoOptions = ref(autoIdParamOptions);\n    return {\n      allAutoOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AAqBA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,kBAAR,QAAiC,mBAAjC;AACA,SAAQC,GAAR,QAAkB,KAAlB;AAEA,eAAe;EACbC,IAAI,EAAE,iBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MAACC,MAAM,EAAE;QAACC,WAAW,EAAE;MAAd,CAAT;MAA6BC,SAAS,EAAE;IAAxC,CAAP;EACD,CARY;;EASbC,OAAO,GAAG;IACR,KAAKC,UAAL;EACD,CAXY;;EAYbC,OAAO,EAAE;IACPD,UAAU,GAAG;MACXZ,eAAe,CAAC,KAAKK,IAAN,EAAY,KAAKG,MAAjB,CAAf,CAAwCM,IAAxC,CAA8CC,GAAD,IAAS;QAAE,KAAKL,SAAL,GAAiBK,GAAjB;MAAqB,CAA7E;IACF;;EAHO,CAZI;;EAiBbC,KAAK,GAAG;IACN,MAAMC,cAAa,GAAIf,GAAG,CAACD,kBAAD,CAA1B;IACA,OAAO;MAACgB;IAAD,CAAP;EACF;;AApBa,CAAf","names":["getTableRecords","autoIdParamOptions","ref","name","props","link","String","data","params","autoIdParam","tableData","mounted","updateData","methods","then","ret","setup","allAutoOptions"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\bdbdbdbdbdbd\\1\\frontend\\src\\components\\Queries\\DriverListQuery.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n    <div class=\"all\">\n      <div class=\"selectDropdown\">\n        <el-select-v2\n            v-model=\"this.params.autoIdParam\"\n            :options=\"this.allAutoOptions\"\n            placeholder=\"Select Auto Id\"\n        />\n      </div>\n      <el-button class=\"submit\" type=\"success\" round @click=\"this.updateData()\">Submit</el-button>\n    </div>\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {autoIdParamOptions} from \"@/data/parameters\";\nimport {ref} from \"vue\";\n\nexport default {\n  name: \"DriverListQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {params: {autoIdParam: null},tableData: {}}\n  },\n  mounted() {\n    this.updateData()\n  },\n  methods: {\n    updateData() {\n      getTableRecords(this.link, this.params).then((ret) => { this.tableData = ret})\n    }\n  },\n  setup() {\n    const allAutoOptions = ref(autoIdParamOptions)\n    return {allAutoOptions}\n  }\n}\n</script>\n\n<style scoped>\n.submit {\n  margin-left: 20px;\n  margin-bottom: 30px;\n}\n\n.selectDropdown {\n  margin-bottom: 30px;\n}\n\n.all {\n  display: inline-flex;\n}\n\nh1 {\n  position: center;\n  font-size: 50px;\n  font-family: \"Akshar\";\n}\n</style>"]},"metadata":{},"sourceType":"module"}