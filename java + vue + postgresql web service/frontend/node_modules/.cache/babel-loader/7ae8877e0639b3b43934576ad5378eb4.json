{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { autoIdParamOptions, typeNameParamOptions, partsListParamOptions } from \"@/data/parameters\";\nimport { ref } from \"vue\";\nexport default {\n  name: \"RepairCountAndCostQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        partsListParam: null,\n        autoIdParam: null,\n        typeNameParam: null,\n        startDateParam: null,\n        endDateParam: null\n      },\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.updateData();\n  },\n\n  methods: {\n    updateData() {\n      console.log(this.params.startDateParam);\n      console.log(this.params.endDateParam);\n      getTableRecords(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    }\n\n  },\n\n  setup() {\n    const allPartsListOptions = ref(partsListParamOptions);\n    const allAutoOptions = ref(autoIdParamOptions);\n    const allTypeNameOptions = ref(typeNameParamOptions);\n    return {\n      allPartsListOptions,\n      allAutoOptions,\n      allTypeNameOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AAsDA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,kBAAR,EAA4BC,oBAA5B,EAAkDC,qBAAlD,QAA8E,mBAA9E;AACA,SAAQC,GAAR,QAAkB,KAAlB;AAEA,eAAe;EACbC,IAAI,EAAE,yBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,MAAM,EAAE;QACNC,cAAc,EAAE,IADV;QAENC,WAAW,EAAE,IAFP;QAGNC,aAAa,EAAE,IAHT;QAINC,cAAc,EAAE,IAJV;QAKNC,YAAY,EAAE;MALR,CADH;MAQLC,SAAS,EAAE;IARN,CAAP;EASD,CAhBY;;EAiBbC,OAAO,GAAG;IACR,KAAKC,UAAL;EACD,CAnBY;;EAoBbC,OAAO,EAAE;IACPD,UAAU,GAAG;MACXE,OAAO,CAACC,GAAR,CAAY,KAAKX,MAAL,CAAYI,cAAxB;MACAM,OAAO,CAACC,GAAR,CAAY,KAAKX,MAAL,CAAYK,YAAxB;MACAf,eAAe,CAAC,KAAKO,IAAN,EAAY,KAAKG,MAAjB,CAAf,CAAwCY,IAAxC,CAA8CC,GAAD,IAAS;QAAE,KAAKP,SAAL,GAAiBO,GAAjB;MAAqB,CAA7E;IACF;;EALO,CApBI;;EA2BbC,KAAK,GAAG;IACN,MAAMC,mBAAkB,GAAIrB,GAAG,CAACD,qBAAD,CAA/B;IACA,MAAMuB,cAAa,GAAItB,GAAG,CAA