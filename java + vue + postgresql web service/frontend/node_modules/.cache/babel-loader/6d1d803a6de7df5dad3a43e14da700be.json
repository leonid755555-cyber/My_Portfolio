active({\n        username: '',\n        password: ''\n      })\n    }\n  },\n  methods: {\n    async login() {\n      try {\n        await axios.post(this.link, this.form)\n        this.getTable()\n      } catch (e) {\n        console.log(e);\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22a2e3;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}