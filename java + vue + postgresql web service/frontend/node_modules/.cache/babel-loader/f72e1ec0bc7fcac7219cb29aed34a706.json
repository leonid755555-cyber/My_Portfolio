{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive } from \"vue\";\nimport { ref } from \"vue\";\nimport { organisationIdParamOptions } from \"@/data/parameters\";\nexport default {\n  name: \"OrganisationTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        name: ''\n      })\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form);\n        this.getTable();\n        this.allOrganisationOptions.push({\n          value: response.data.id,\n          label: response.data.name\n        });\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  },\n\n  setup() {\n    const allOrganisationOptions = ref(organisationIdParamOptions);\n    return {\n      allOrganisationOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AA8BA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AACA,SAAQC,GAAR,QAAkB,KAAlB;AACA,SAAQC,0BAAR,QAAyC,mBAAzC;AAEA,eAAe;EACbC,IAAI,EAAE,mBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,SAAS,EAAE,EADN;MAELC,IAAI,EAAET,QAAQ,CAAC;QACbG,IAAI,EAAE;MADO,CAAD;IAFT,CAAP;EAMD,CAbY;;EAcbO,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CAhBY;;EAiBbC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACTf,eAAe,CAAC,KAAKS,IAAN,EAAY,IAAZ,CAAf,CAAiCQ,IAAjC,CAAuCC,GAAD,IAAS;QAAE,KAAKN,SAAL,GAAiBM,GAAjB;MAAqB,CAAtE;IACD,CAHM;;IAIP,MAAMC,YAAN,CAAmBC,GAAnB,EAAwB;MACtB,IAAIC,EAAC,GAAI,KAAKT,SAAL,CAAeU,IAAf,CAAoBF,GAApB,EAAyBC,EAAlC;;MACA,IAAI,MAAMnB,YAAY,CAACqB,OAAb,CAAqB,2CAArB,EACN,SADM,EAEN;QACEC,iBAAiB,EAAE,IADrB;QAEEC,gBAAgB,EAAE,QAFpB;QAGEC,IAAI,EAAE;MAHR,CAFM,CAAV,EAMQ;QACN,IAAI;UACF,MAAMvB,KAAK,CAACwB,MAAN,CAAa,KAAKlB,IAAL,GAAY,GAAZ,GAAkBY,EAA/B,CAAN;UACA,KAAKT,SAAL,CAAeU,IAAf,CAAoBM,MAApB,CAA2BR,GAA3B,EAAgC,CAAhC;UACAnB,SAAS,CAAC;YACRyB,IAAI,EAAE,SADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF,CAPA,CAOE,OAAOC,CAAP,EAAU;UACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;UACA7B,SAAS,CAAC;YACRyB,IAAI,EAAE,MADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF;MACF;IACD,CA5BM;;IA6BP,MAAMI,YAAN,GAAqB;MACnB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAM/B,KAAK,CAACgC,IAAN,CAAW,KAAK1B,IAAhB,EAAsB,KAAKI,IAA3B,CAAvB;QACA,KAAKE,QAAL;QACA,KAAKqB,sBAAL,CAA4BC,IAA5B,CAAiC;UAC/BC,KAAK,EAAEJ,QAAQ,CAACvB,IAAT,CAAcU,EADU;UAE/BkB,KAAK,EAAEL,QAAQ,CAACvB,IAAT,CAAcJ;QAFU,CAAjC;MAIF,CAPA,CAOE,OAAOuB,CAAP,EAAU;QACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;MACF;IACF;;EAxCO,CAjBI;;EA2DbU,KAAK,GAAG;IACN,MAAMJ,sBAAqB,GAAI/B,GAAG,CAACC,0BAAD,CAAlC;IACA,OAAO;MAAC8B;IAAD,CAAP;EACF;;AA9Da,CAAf","names":["getTableRecords","ElMessage","ElMessageBox","axios","reactive","ref","organisationIdParamOptions","name","props","link","String","data","tableData","form","mounted","getTable","methods","then","ret","deleteEntity","idx","id","rows","confirm","confirmButtonText","cancelButtonText","type","delete","splice","message","e","console","log","createEntity","response","post","allOrganisationOptions","push","value","label","setup"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\nsu-database-main\\frontend\\src\\components\\Tables\\OrganisationTable.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n\n    <div class=\"createForm\">\n      <el-form :model=\"form\">\n        <el-form-item label=\"Organisation name\">\n          <el-input v-model=\"form.name\" />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button class=\"submit\" type=\"success\" round @click=\"createEntity\">Create</el-button>\n\n        </el-form-item>\n      </el-form>\n    </div>\n\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n      <el-table-column label=\"Delete Record\">\n        <template #default=\"scope\">\n          <el-button type=\"danger\" round  v-on:click=\"deleteEntity(scope.$index)\">Delete</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {ElMessage, ElMessageBox} from \"element-plus\";\nimport axios from \"axios\";\nimport {reactive} from \"vue\";\nimport {ref} from \"vue\";\nimport {organisationIdParamOptions} from \"@/data/parameters\";\n\nexport default {\n  name: \"OrganisationTable\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        name: ''\n      })\n    }\n  },\n  mounted() {\n    this.getTable()\n  },\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then((ret) => { this.tableData = ret})\n    },\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\",\n          'Warning',\n          {\n            confirmButtonText: 'OK',\n            cancelButtonText: 'Cancel',\n            type: 'warning',\n          })) {\n        try {\n          await axios.delete(this.link + \"/\" + id)\n          this.tableData.rows.splice(idx, 1)\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted',\n          })\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted',\n          });\n        }\n      }\n    },\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form)\n        this.getTable()\n        this.allOrganisationOptions.push({\n          value: response.data.id,\n          label: response.data.name,\n        })\n      } catch (e) {\n        console.log(e);\n      }\n    }\n  },\n  setup() {\n    const allOrganisationOptions = ref(organisationIdParamOptions)\n    return {allOrganisationOptions}\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22c0c2;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}