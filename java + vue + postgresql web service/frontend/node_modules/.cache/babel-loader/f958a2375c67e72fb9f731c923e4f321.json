{"ast":null,"code":"import axios from \"axios\";\nimport { reactive } from \"vue\";\nimport { ref } from \"vue\";\nimport { ElMessage } from \"element-plus\";\nconst dialogFormVisible = ref(false);\nexport default {\n  name: \"UserName\",\n\n  data() {\n    return {\n      form: reactive({\n        username: '',\n        password: '',\n        passwordConfirm: '',\n        question: '',\n        answer: ''\n      }),\n      dialogFormVisible\n    };\n  },\n\n  methods: {\n    async tryUser() {\n      try {\n        const responce = await axios.get(\"/username/\" + this.form.username);\n        this.form.question = responce.question;\n      } catch (e) {\n        console.log(e);\n        ElMessage({\n          type: 'info',\n          message: 'Wrong username'\n        });\n      }\n    }\n\n  }\n};","map":{"version":3,"mappings":"AAoCA,OAAOA,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AACA,SAAQC,GAAR,QAAkB,KAAlB;AACA,SAAQC,SAAR,QAAwB,cAAxB;AACA,MAAMC,iBAAgB,GAAIF,GAAG,CAAC,KAAD,CAA7B;AACA,eAAe;EACbG,IAAI,EAAE,UADO;;EAEbC,IAAI,GAAG;IACL,OAAO;MACLC,IAAI,EAAEN,QAAQ,CAAC;QACbO,QAAQ,EAAE,EADG;QAEbC,QAAQ,EAAE,EAFG;QAGbC,eAAe,EAAE,EAHJ;QAIbC,QAAQ,EAAE,EAJG;QAKbC,MAAM,EAAE;MALK,CAAD,CADT;MAQLR;IARK,CAAP;EAUD,CAbY;;EAcbS,OAAO,EAAE;IACP,MAAMC,OAAN,GAAgB;MACd,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMf,KAAK,CAACgB,GAAN,CAAU,eAAe,KAAKT,IAAL,CAAUC,QAAnC,CAAvB;QACA,KAAKD,IAAL,CAAUI,QAAV,GAAqBI,QAAQ,CAACJ,QAA9B;MACF,CAHA,CAGE,OAAOM,CAAP,EAAU;QACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;QACAd,SAAS,CAAC;UACNiB,IAAI,EAAE,MADA;UAENC,OAAO,EAAE;QAFH,CAAD,CAAT;MAKF;IACF;;EAbO;AAdI,CAAf","names":["axios","reactive","ref","ElMessage","dialogFormVisible","name","data","form","username","password","passwordConfirm","question","answer","methods","tryUser","responce","get","e","console","log","type","message"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\work\\bdbdbdbdbdbd\\1\\1lab\\frontend\\src\\components\\UserNamePage.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>Enter your Username</h1>\n\n    <div class=\"createForm\">\n      <el-form :model=\"form\">\n        <el-form-item label=\"User Name\">\n          <el-input v-model=\"form.username\" />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button class=\"submit\" type=\"success\" round @click=\"tryUser(); dialogFormVisible = true;\">Continue</el-button>\n\n        </el-form-item>\n      </el-form>\n    </div>\n\n<el-dialog v-model=\"dialogFormVisible\" title=\"{{this.form.question}}\">\n        <el-form :model=\"form\">\n\n          <el-form-item label=\"Answer\">\n            <el-input v-model=\"form.answer\" />\n          </el-form-item>\n      </el-form>\n           <template #footer>\n        <span class=\"dialog-footer\">\n          <el-button @click=\"dialogFormVisible = false\">Cancel</el-button>\n          <el-button type=\"primary\" @click=\"updateEntity(); dialogFormVisible = false;\">Confirm</el-button>\n        </span>\n      </template>\n    </el-dialog>\n\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport {reactive} from \"vue\";\nimport {ref} from \"vue\";\nimport {ElMessage} from \"element-plus\";\nconst dialogFormVisible = ref(false);\nexport default {\n  name: \"UserName\",\n  data() {\n    return {\n      form: reactive({\n        username: '',\n        password: '',\n        passwordConfirm: '',\n        question: '',\n        answer: ''\n      }),\n      dialogFormVisible\n    }\n  },\n  methods: {\n    async tryUser() {\n      try {\n        const responce = await axios.get(\"/username/\" + this.form.username);\n        this.form.question = responce.question;\n      } catch (e) {\n        console.log(e); \n        ElMessage({\n            type: 'info',\n            message: 'Wrong username',\n         \n        })\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22a2e3;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}