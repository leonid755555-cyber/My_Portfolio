{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { objectIdParamOptions } from \"@/data/parameters\";\nimport { ref } from \"vue\";\nexport default {\n  name: \"EquipmentOnObjectListQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        objectIdParam: null,\n        startDateParam: null,\n        endDateParam: null\n      },\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.updateData();\n  },\n\n  methods: {\n    updateData() {\n      console.log(this.params.startDateParam);\n      console.log(this.params.endDateParam);\n      getTableRecords(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    }\n\n  },\n\n  setup() {\n    const allObjectOptions = ref(objectIdParamOptions);\n    return {\n      allObjectOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AAqCA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,oBAAR,QAAmC,mBAAnC;AACA,SAAQC,GAAR,QAAkB,KAAlB;AAEA,eAAe;EACbC,IAAI,EAAE,4BADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,MAAM,EAAE;QACNC,aAAa,EAAE,IADT;QAENC,cAAc,EAAE,IAFV;QAGNC,YAAY,EAAE;MAHR,CADH;MAMLC,SAAS,EAAE;IANN,CAAP;EAOD,CAdY;;EAebC,OAAO,GAAG;IACR,KAAKC,UAAL;EACD,CAjBY;;EAkBbC,OAAO,EAAE;IACPD,UAAU,GAAG;MACXE,OAAO,CAACC,GAAR,CAAY,KAAKT,MAAL,CAAYE,cAAxB;MACAM,OAAO,CAACC,GAAR,CAAY,KAAKT,MAAL,CAAYG,YAAxB;MACAX,eAAe,CAAC,KAAKK,IAAN,EAAY,KAAKG,MAAjB,CAAf,CAAwCU,IAAxC,CAA8CC,GAAD,IAAS;QAAE,KAAKP,SAAL,GAAiBO,GAAjB;MAAqB,CAA7E;IACF;;EALO,CAlBI;;EAyBbC,KAAK,GAAG;IACN,MAAMC,gBAAe,GAAInB,GAAG,CAACD,oBAAD,CAA5B;IACA,OAAO;MAACoB;IAAD,CAAP;EACF;;AA5Ba,CAAf","names":["getTableRecords","objectIdParamOptions","ref","name","props","link","String","data","params","objectIdParam","startDateParam","endDateParam","tableData","mounted","updateData","methods","console","log","then","ret","setup","allObjectOptions"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\bdbdbdbdbdbd\\1\\frontend\\src\\components\\Queries\\EquipmentOnObjectListQuery.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n    <div class=\"all\">\n      <div class=\"selectDropdown\">\n        <el-select-v2\n            v-model=\"this.params.objectIdParam\"\n            :options=\"this.allObjectOptions\"\n            placeholder=\"Select Object\"\n        />\n      </div>\n\n      <div class=\"date\">\n        <el-date-picker v-model=\"this.params.startDateParam\"\n                        type=\"date\"\n                        placeholder=\"Pick Start Date\"\n                        format=\"YYYY/MM/DD\"\n                        value-format=\"YYYY-MM-DD\"/>\n      </div>\n\n      <div class=\"date\">\n        <el-date-picker v-model=\"this.params.endDateParam\"\n                        type=\"date\"\n                        placeholder=\"Pick End Date\"\n                        format=\"YYYY/MM/DD\"\n                        value-format=\"YYYY-MM-DD\"/>\n      </div>\n      <el-button class=\"submit\" type=\"success\" round @click=\"this.updateData()\">Submit</el-button>\n    </div>\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {objectIdParamOptions} from \"@/data/parameters\";\nimport {ref} from \"vue\";\n\nexport default {\n  name: \"EquipmentOnObjectListQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {\n      params: {\n        objectIdParam: null,\n        startDateParam: null,\n        endDateParam: null\n      },\n      tableData: {}}\n  },\n  mounted() {\n    this.updateData()\n  },\n  methods: {\n    updateData() {\n      console.log(this.params.startDateParam)\n      console.log(this.params.endDateParam)\n      getTableRecords(this.link, this.params).then((ret) => { this.tableData = ret})\n    }\n  },\n  setup() {\n    const allObjectOptions = ref(objectIdParamOptions)\n    return {allObjectOptions}\n  }\n}\n</script>\n\n<style scoped>\n.submit {\n  margin-left: 20px;\n  margin-bottom: 30px;\n}\n\n.selectDropdown {\n  margin-left: 20px;\n  margin-right: 20px;\n  margin-bottom: 30px;\n}\n\n.date {\n  margin-left: 20px;\n  margin-right: 20px;\n  margin-bottom: 30px;\n}\n\n.all {\n  display: inline-flex;\n}\n\nh1 {\n  position: center;\n  font-size: 50px;\n  font-family: \"Akshar\";\n}\n</style>"]},"metadata":{},"sourceType":"module"}