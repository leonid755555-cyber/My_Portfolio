{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { organisationIdParamOptions, workTypeIdParamOptions } from \"@/data/parameters\";\nimport { ref } from \"vue\";\nexport default {\n  name: \"ObjectWorkTypeListQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        organisationIdParam: null,\n        startDateParam: null,\n        endDateParam: null,\n        workTypeIdParam: null\n      },\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.updateData();\n  },\n\n  methods: {\n    updateData() {\n      console.log(this.params.startDateParam);\n      console.log(this.params.endDateParam);\n      getTableRecords(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    }\n\n  },\n\n  setup() {\n    const allOrganisationOptions = ref(organisationIdParamOptions);\n    const allWorkTypeOptions = ref(workTypeIdParamOptions);\n    return {\n      allOrganisationOptions,\n      allWorkTypeOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AA6CA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,0BAAR,EAAoCC,sBAApC,QAAiE,mBAAjE;AACA,SAAQC,GAAR,QAAkB,KAAlB;AACA,eAAe;EACbC,IAAI,EAAE,yBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,MAAM,EAAE;QACNC,mBAAmB,EAAE,IADf;QAENC,cAAc,EAAE,IAFV;QAGNC,YAAY,EAAE,IAHR;QAINC,eAAe,EAAE;MAJX,CADH;MAOLC,SAAS,EAAE;IAPN,CAAP;EAQD,CAfY;;EAgBbC,OAAO,GAAG;IACR,KAAKC,UAAL;EACD,CAlBY;;EAmBbC,OAAO,EAAE;IACPD,UAAU,GAAG;MACXE,OAAO,CAACC,GAAR,CAAY,KAAKV,MAAL,CAAYE,cAAxB;MACAO,OAAO,CAACC,GAAR,CAAY,KAAKV,MAAL,CAAYG,YAAxB;MACAZ,eAAe,CAAC,KAAKM,IAAN,EAAY,KAAKG,MAAjB,CAAf,CAAwCW,IAAxC,CAA8CC,GAAD,IAAS;QAAE,KAAKP,SAAL,GAAiBO,GAAjB;MAAqB,CAA7E;IACF;;EALO,CAnBI;;EA0BbC,KAAK,GAAG;IACN,MAAMC,sBAAqB,GAAIpB,GAAG,CAACF,0BAAD,CAAlC;IACA,MAAMuB,kBAAiB,GAAIrB,GAAG,CAACD,sBAAD,CAA9B;IACA,OAAO;MAACqB,sBAAD;MAAyBC;IAAzB,CAAP;EACF;;AA9Ba,CAAf","names":["getTableRecords","organisationIdParamOptions","workTypeIdParamOptions","ref","name","props","link","String","data","params","organisationIdParam","startDateParam","endDateParam","workTypeIdParam","tableData","mounted","updateData","methods","console","log","then","ret","setup","allOrganisationOptions","allWorkTypeOptions"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\nsu-database-main\\frontend\\src\\components\\Queries\\ObjectWorkTypeListQuery.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n    <div class=\"all\">\n      <div class=\"selectDropdown\">\n        <el-select-v2\n            v-model=\"this.params.organisationIdParam\"\n            :options=\"this.allOrganisationOptions\"\n            placeholder=\"Select Organisation\"\n        />\n      </div>\n\n      <div class=\"date\">\n        <el-date-picker v-model=\"this.params.startDateParam\"\n                        type=\"date\"\n                        placeholder=\"Pick Start Date\"\n                        format=\"YYYY/MM/DD\"\n                        value-format=\"YYYY-MM-DD\"/>\n      </div>\n\n      <div class=\"date\">\n        <el-date-picker v-model=\"this.params.endDateParam\"\n                        type=\"date\"\n                        placeholder=\"Pick End Date\"\n                        format=\"YYYY/MM/DD\"\n                        value-format=\"YYYY-MM-DD\"/>\n      </div>\n\n      <div class=\"selectDropdown\">\n        <el-select-v2\n            v-model=\"this.params.workTypeIdParam\"\n            :options=\"this.allWorkTypeOptions\"\n            placeholder=\"Select Work Type\"\n        />\n      </div>\n      <el-button class=\"submit\" type=\"success\" round @click=\"this.updateData()\">Submit</el-button>\n    </div>\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {organisationIdParamOptions, workTypeIdParamOptions} from \"@/data/parameters\";\nimport {ref} from \"vue\";\nexport default {\n  name: \"ObjectWorkTypeListQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {\n      params: {\n        organisationIdParam: null,\n        startDateParam: null,\n        endDateParam: null,\n        workTypeIdParam: null\n      },\n      tableData: {}}\n  },\n  mounted() {\n    this.updateData()\n  },\n  methods: {\n    updateData() {\n      console.log(this.params.startDateParam)\n      console.log(this.params.endDateParam)\n      getTableRecords(this.link, this.params).then((ret) => { this.tableData = ret})\n    }\n  },\n  setup() {\n    const allOrganisationOptions = ref(organisationIdParamOptions)\n    const allWorkTypeOptions = ref(workTypeIdParamOptions)\n    return {allOrganisationOptions, allWorkTypeOptions}\n  }\n}\n</script>\n\n<style scoped>\n.submit {\n  margin-left: 20px;\n  margin-bottom: 30px;\n}\n\n.selectDropdown {\n  margin-left: 20px;\n  margin-right: 20px;\n  margin-bottom: 30px;\n}\n\n.date {\n  margin-left: 20px;\n  margin-right: 20px;\n  margin-bottom: 30px;\n}\n\n.all {\n  display: inline-flex;\n}\n\nh1 {\n  position: center;\n  font-size: 50px;\n  font-family: \"Akshar\";\n}\n</style>"]},"metadata":{},"sourceType":"module"}