{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive } from \"vue\";\nimport { ref } from \"vue\";\nimport { personIdParamOptions, postIdParamOptions } from \"@/data/parameters\";\nconst dialogFormVisible = ref(false);\nexport default {\n  name: \"EmplTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        fio: '',\n        postId: {\n          id: ''\n        },\n        headId: ''\n      }),\n      dialogFormVisible\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    async updateEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.prompt('Please input your e-mail', 'Tip', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form);\n        this.getTable();\n        this.allpersonIdOptions.push({\n          value: response.data.id,\n          label: response.data.fio\n        });\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  },\n\n  setup() {\n    const allpersonIdOptions = ref(personIdParamOptions);\n    const allpostIdOptions = ref(postIdParamOptions);\n    return {\n      allpersonIdOptions,\n      allpostIdOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AA6EA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AACA,SAAQC,GAAR,QAAkB,KAAlB;AACA,SAAQC,oBAAR,EAA8BC,kBAA9B,QAAuD,mBAAvD;AACA,MAAMC,iBAAgB,GAAIH,GAAG,CAAC,KAAD,CAA7B;AACA,eAAe;EACbI,IAAI,EAAE,WADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,SAAS,EAAE,EADN;MAELC,IAAI,EAAEX,QAAQ,CAAC;QACbY,GAAG,EAAE,EADQ;QAEbC,MAAM,EAAE;UAACC,EAAE,EAAC;QAAJ,CAFK;QAGbC,MAAM,EAAE;MAHK,CAAD,CAFT;MAOLX;IAPK,CAAP;EASD,CAhBY;;EAiBbY,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CAnBY;;EAoBbC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACTrB,eAAe,CAAC,KAAKW,IAAN,EAAY,IAAZ,CAAf,CAAiCY,IAAjC,CAAuCC,GAAD,IAAS;QAAE,KAAKV,SAAL,GAAiBU,GAAjB;MAAqB,CAAtE;IACD,CAHM;;IAIP,MAAMC,YAAN,CAAmBC,GAAnB,EAAwB;MACtB,IAAIR,EAAC,GAAI,KAAKJ,SAAL,CAAea,IAAf,CAAoBD,GAApB,EAAyBR,EAAlC;;MACA,IAAI,MAAMhB,YAAY,CAAC0B,OAAb,CAAqB,2CAArB,EACN,SADM,EAEN;QACEC,iBAAiB,EAAE,IADrB;QAEEC,gBAAgB,EAAE,QAFpB;QAGEC,IAAI,EAAE;MAHR,CAFM,CAAV,EAMQ;QACN,IAAI;UACF,MAAM5B,KAAK,CAAC6B,MAAN,CAAa,KAAKrB,IAAL,GAAY,GAAZ,GAAkBO,EAA/B,CAAN;UACA,KAAKJ,SAAL,CAAea,IAAf,CAAoBM,MAApB,CAA2BP,GAA3B,EAAgC,CAAhC;UACAzB,SAAS,CAAC;YACR8B,IAAI,EAAE,SADE;YAERG,OAAO,EAAE