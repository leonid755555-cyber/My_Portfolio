{"ast":null,"code":"import { getTableRecords1 } from \"@/getTableRecords\";\nexport default {\n  name: \"Transport_emplTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        offset: 0\n      },\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    nextPage() {\n      this.params.offset++;\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    prevPage() {\n      this.params.offset--;\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    }\n\n  }\n};","map":{"version":3,"mappings":"AAgBA,SAAQA,gBAAR,QAA+B,mBAA/B;AAEA,eAAe;EACbC,IAAI,EAAE,qBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMXC,IAAI,GAAG;IACP,OAAO;MACLC,MAAM,EAAE;QAACC,MAAM,EAAE;MAAT,CADH;MAELC,SAAS,EAAE;IAFN,CAAP;EAID,CAXY;;EAYbC,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CAdY;;EAebC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACTV,gBAAgB,CAAC,KAAKG,IAAN,EAAY,KAAKG,MAAjB,CAAhB,CAAyCM,IAAzC,CAA+CC,GAAD,IAAS;QAAE,KAAKL,SAAL,GAAiBK,GAAjB;MAAqB,CAA9E;IACD,CAHM;;IAIPC,QAAQ,GAAE;MACP,KAAKR,MAAL,CAAYC,MAAZ;MACCP,gBAAgB,CAAC,KAAKG,IAAN,EAAY,KAAKG,MAAjB,CAAhB,CAAyCM,IAAzC,CAA+CC,GAAD,IAAS;QAAE,KAAKL,SAAL,GAAiBK,GAAjB;MAAqB,CAA9E;IACH,CAPM;;IAQPE,QAAQ,GAAE;MACR,KAAKT,MAAL,CAAYC,MAAZ;MACAP,gBAAgB,CAAC,KAAKG,IAAN,EAAY,KAAKG,MAAjB,CAAhB,CAAyCM,IAAzC,CAA+CC,GAAD,IAAS;QAAE,KAAKL,SAAL,GAAiBK,GAAjB;MAAqB,CAA9E;IACF;;EAXO;AAfI,CAAf","names":["getTableRecords1","name","props","link","String","data","params","offset","tableData","mounted","getTable","methods","then","ret","nextPage","prevPage"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\spring-reg-auth-master (3)\\spring-reg-auth-master\\src\\main\\webapp\\1\\src\\components\\Tables\\Transport_emplTable.vue"],"