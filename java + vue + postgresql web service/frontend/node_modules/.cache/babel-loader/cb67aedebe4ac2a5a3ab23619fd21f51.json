{"ast":null,"code":"import axios from \"axios\";\nimport { reactive } from \"vue\";\nimport { ElMessage } from \"element-plus\";\nexport default {\n  name: \"RegistrationPage\",\n\n  mounted() {\n    localStorage.setItem('role', '0');\n  },\n\n  data() {\n    return {\n      form: reactive({\n        username: '',\n        password: '',\n        passwordConfirm: '',\n        question: '',\n        answer: ''\n      })\n    };\n  },\n\n  methods: {\n    async register() {\n      try {\n        if (this.form.password === this.form.passwordConfirm) {\n          await axios.post(\"/registration\", this.form);\n        } else {\n          ElMessage({\n            type: 'info',\n            message: 'Passwords do not match'\n          });\n        }\n      } catch (e) {\n        console.log(e);\n        ElMessage({\n          type: 'info',\n          message: 'unexpected error'\n        });\n      }\n    }\n\n  }\n};","map":{"version":3,"mappings":"AAqCA,OAAOA,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AACA,SAAQC,SAAR,QAAwB,cAAxB;AACA,eAAe;EACbC,IAAI,EAAE,kBADO;;EAEbC,OAAO,GAAG;IACRC,YAAY,CAACC,OAAb,CAAqB,MAArB,EAA6B,GAA7B;EACD,CAJY;;EAKbC,IAAI,GAAG;IACL,OAAO;MACLC,IAAI,EAAEP,QAAQ,CAAC;QACbQ,QAAQ,EAAE,EADG;QAEbC,QAAQ,EAAE,EAFG;QAGbC,eAAe,EAAE,EAHJ;QAIbC,QAAQ,EAAE,EAJG;QAKbC,MAAM,EAAE;MALK,CAAD;IADT,CAAP;EASD,CAfY;;EAgBbC,OAAO,EAAE;IACP,MAAMC,QAAN,GAAiB;MACf,IAAI;QACJ,IAAG,KAAKP,IAAL,CAAUE,QAAV,KAAuB,KAAKF,IAAL,CAAUG,eAApC,EACA;UACM,MAAMX,KAAK,CAACgB,IAAN,CAAW,eAAX,EAA4B,KAAKR,IAAjC,CAAN;QACN,CAHA,MAKE;UACAN,SAAS,CAAC;YACNe,IAAI,EAAE,MADA;YAENC,OAAO,EAAE;UAFH,CAAD,CAAT;QAKA;MACF,CAbA,CAaE,OAAOC,CAAP,EAAU;QACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;QACAjB,SAAS,CAAC;UACNe,IAAI,EAAE,MADA;UAENC,OAAO,EAAE;QAFH,CAAD,CAAT;MAMF;IACF;;EAxBO;AAhBI,CAAf","names":["axios","reactive","ElMessage","name","mounted","localStorage","setItem","data","form","username","password","passwordConfirm","question","answer","methods","register","post","type","message","e","console","log"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\work\\bdbdbdbdbdbd\\1\\1lab\\frontend\\src\\components\\RegistrationPage.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>Register</h1>\n\n    <div class=\"createForm\">\n      <el-form :model=\"form\">\n        <el-form-item label=\"User Name\">\n          <el-input v-model=\"form.username\" />\n        </el-form-item>\n\n        <el-form-item label=\"Password\">\n          <el-input :type=\"showInput ? text : hidden\" v-model=\"form.password\" />\n        </el-form-item>\n\n        <el-form-item label=\"Confirm password\">\n          <el-input  :type=\"showInput ? text : hidden\" v-model=\"form.passwordConfirm\" />\n        </el-form-item>\n\n        <el-form-item label=\"Question\">\n          <el-input v-model=\"form.question\" />\n        </el-form-item>\n\n        <el-form-item label=\"Answer\">\n          <el-input v-model=\"form.answer\" />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button class=\"submit\" type=\"success\" round @click=\"register\">Register</el-button>\n\n        </el-form-item>\n      </el-form>\n    </div>\n\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport {reactive} from \"vue\";\nimport {ElMessage} from \"element-plus\";\nexport default {\n  name: \"RegistrationPage\",\n  mounted() {\n    localStorage.setItem('role', '0');\n  },\n  data() {\n    return {\n      form: reactive({\n        username: '',\n        password: '',\n        passwordConfirm: '',\n        question: '',\n        answer: ''\n      })\n    }\n  },\n  methods: {\n    async register() {\n      try {\n      if(this.form.password === this.form.passwordConfirm)\n      {\n            await axios.post(\"/registration\", this.form)\n      }\n        else\n        {\n        ElMessage({\n            type: 'info',\n            message: 'Passwords do not match',\n         \n        });\n        }\n      } catch (e) {\n        console.log(e);\n        ElMessage({\n            type: 'info',\n            message: 'unexpected error',\n         \n        });\n\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22a2e3;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}