{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive } from \"vue\";\nexport default {\n  name: \"PartsTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        name: ''\n      })\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    async updateEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n      ElMessageBox.prompt('name', 'Tip', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        inputErrorMessage: 'Invalid Email'\n      }).then(async ({\n        value\n      }) => {\n        this.form.id = id;\n        this.form.name = value;\n\n        try {\n          const response = await axios.post(this.link, this.form);\n          this.getTable();\n          this.allpersonIdOptions.push({\n            value: response.data.id,\n            label: response.data.FIO\n          });\n        } catch (e) {\n          console.log(e);\n        }\n      });\n    },\n\n    async createEntity() {\n      try {\n        const response = await axios.post(this.link, this.form);\n        this.getTable();\n        this.allpersonIdOptions.push({\n          value: response.data.id,\n          label: response.data.FIO\n        });\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  }\n};","map":{"version":3,"mappings":"AAoCA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AAEA,eAAe;EACbC,IAAI,EAAE,YADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMXC,IAAI,GAAG;IACP,OAAO;MACLC,SAAS,EAAE,EADN;MAELC,IAAI,EAAEP,QAAQ,CAAC;QACXC,IAAI,EAAE;MADK,CAAD;IAFT,CAAP;EAMD,CAbY;;EAcbO,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CAhBY;;EAiBbC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACTb,eAAe,CAAC,KAAKO,IAAN,EAAY,IAAZ,CAAf,CAAiCQ,IAAjC,CAAuCC,GAAD,IAAS;QAAE,KAAKN,SAAL,GAAiBM,GAAjB;MAAqB,CAAtE;IACD,CAHM;;IAIP,MAAMC,YAAN,CAAmBC,GAAnB,EAAwB;MACtB,IAAIC,EAAC,GAAI,KAAKT,SAAL,CAAeU,IAAf,CAAoBF,GAApB,EAAyBC,EAAlC;;MACA,IAAI,MAAMjB,YAAY,CAACmB,OAAb,CAAqB,2CAArB,EACN,SADM,EAEN;QACEC,iBAAiB,EAAE,IADrB;QAEEC,gBAAgB,EAAE,QAFpB;QAGEC,IAAI,EAAE;MAHR,CAFM,CAAV,EAMQ;QACN,IAAI;UACF,MAAMrB,KAAK,CAACsB,MAAN,CAAa,KAAKlB,IAAL,GAAY,GAAZ,GAAkBY,EAA/B,CAAN;UACA,KAAKT,SAAL,CAAeU,IAAf,CAAoBM,MAApB,CAA2BR,GAA3B,EAAgC,CAAhC;UACAjB,SAAS,CAAC;YACRuB,IAAI,EAAE,SADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF,CAPA,CAOE,OAAOC,CAAP,EAAU;UACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;UACA3B,SAAS,CAAC;YACRuB,IAAI,EAAE,MADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF;MACF;IACD,CA5BM;;IA6BP,MAAMI,YAAN,CAAmBb,GAAnB,EAAwB;MACtB,IAAIC,EAAC,GAAI,KAAKT,SAAL,CAAeU,IAAf,CAAoBF,GAApB,EAAyBC,EAAlC;MACAjB,YAAY,CAAC8B,MAAb,CAAoB,MAApB,EAA4B,KAA5B,EAAmC;QACnCV,iBAAiB,EAAE,IADgB;QAEnCC,gBAAgB,EAAE,QAFiB;QAGnCU,iBAAiB,EAAE;MAHgB,CAAnC,EAKClB,IALD,CAKO,OAAO;QAAEmB;MAAF,CAAP,KAAqB;QAC5B,KAAKvB,IAAL,CAAUQ,EAAV,GAAeA,EAAf;QACA,KAAKR,IAAL,CAAUN,IAAV,GAAiB6B,KAAjB;;QACA,IAAI;UAEF,MAAMC,QAAO,GAAI,MAAMhC,KAAK,CAACiC,IAAN,CAAW,KAAK7B,IAAhB,EAAsB,KAAKI,IAA3B,CAAvB;UACA,KAAKE,QAAL;