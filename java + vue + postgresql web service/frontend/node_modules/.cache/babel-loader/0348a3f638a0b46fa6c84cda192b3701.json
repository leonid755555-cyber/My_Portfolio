ty(scope.$index)\">Delete</el-button>\n        </template>\n      </el-table-column>\n\n      <el-table-column label=\"Update Record\">\n        <template #default=\"scope\">\n          <el-button type=\"warning\" round  @click=\"updateEntity(scope.$index)\">Update</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {ElMessage, ElMessageBox} from \"element-plus\";\nimport axios from \"axios\";\nimport {reactive} from \"vue\";\n\nexport default {\n  name: \"PartsTable\",\n  props: {\n    link: String,\n    name: String\n  },\n    data() {\n    return {\n      tableData: {},\n      form: reactive({\n          name: ''\n      })\n    }\n  },\n  mounted() {\n    this.getTable()\n  },\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then((ret) => { this.tableData = ret})\n    },\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\",\n          'Warning',\n          {\n            confirmButtonText: 'OK',\n            cancelButtonText: 'Cancel',\n            type: 'warning',\n          })) {\n        try {\n          await axios.delete(this.link + \"/\" + id)\n          this.tableData.rows.splice(idx, 1)\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted',\n          })\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted',\n          });\n        }\n      }\n    },\n    async updateEntity(idx) {\n      let id = this.tableData.rows[idx].id\n      ElMessageBox.prompt('name', 'Tip', {\n      confirmButtonText: 'OK',\n      cancelButtonText: 'Cancel',\n      inputErrorMessage: 'Invalid Email',\n    })\n      .then( async ({ value }) => {\n      this.form.id = id\n      this.form.name = value\n      try {\n\n        const response = await axios.post(this.link, this.form)\n        this.getTable()\n        this.allpersonIdOptions.push({\n          value: response.data.id,\n          label: response.data.FIO,\n        })\n        } catch (e) {\n      console.log(e);\n      }\n    })\n  },\n     async createEntity() {\n    try {\n      const response = await axios.post(this.link, this.form)\n      this.getTable()\n      this.allpersonIdOptions.push({\n        value: response.data.id,\n        label: response.data.FIO,\n      })\n    } catch (e) {\n      console.log(e);\n    }\n  } \n}\n}\n</script>\n\n<style scoped>\n\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22a2e3;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}