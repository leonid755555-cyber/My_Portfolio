{"ast":null,"code":"import { getTableRecords1 } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive } from \"vue\";\nimport { ref } from \"vue\";\nimport { autoIdParamOptions } from \"@/data/parameters\";\nconst dialogFormVisible = ref(false);\nexport default {\n  name: \"EmplTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        offset: 0\n      },\n      tableData: {},\n      form: reactive({\n        transportId: '',\n        report_date: '',\n        tickets_count: null,\n        mileage: null,\n        cargo_transportation: null\n      }),\n      form1: reactive({\n        id: '',\n        transportId: '',\n        report_date: '',\n        tickets_count: null,\n        mileage: null,\n        cargo_transportation: null\n      }),\n      dialogFormVisible\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    nextPage() {\n      this.params.offset++;\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    prevPage() {\n      this.params.offset--;\n      getTableRecords1(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    async updateEntity() {\n      try {\n        await axios.post(this.link, this.form1);\n        this.getTable();\n        ElMessage({\n          type: 'success',\n          message: 'Successfully updated'\n        });\n      } catch (e) {\n        console.log(e);\n        ElMessage({\n          type: 'info',\n          message: 'Unsuccessfully updated'\n        });\n      }\n    },\n\n    async createEntity() {\n      try {\n        await axios.post(this.link, this.form);\n        this.getTable();\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  },\n\n  setup() {\n    const allAutoIdOptions = ref(autoIdParamOptions);\n    return {\n      allAutoIdOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AA8GA,SAAQA,gBAAR,QAA+B,mBAA/B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,QAAuB,KAAvB;AACA,SAAQC,GAAR,QAAkB,KAAlB;AACA,SAAQC,kBAAR,QAAiC,mBAAjC;AACA,MAAMC,iBAAgB,GAAIF,GAAG,CAAC,KAAD,CAA7B;AAEA,eAAe;EACbG,IAAI,EAAE,WADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,MAAM,EAAE;QAACC,MAAM,EAAE;MAAT,CADH;MAELC,SAAS,EAAE,EAFN;MAGLC,IAAI,EAAEZ,QAAQ,CAAC;QACba,WAAW,EAAE,EADA;QAEbC,WAAW,EAAE,EAFA;QAGbC,aAAa,EAAE,IAHF;QAIbC,OAAO,EAAE,IAJI;QAKbC,oBAAoB,EAAE;MALT,CAAD,CAHT;MAULC,KAAK,EAAElB,QAAQ,CAAC;QACdmB,EAAE,EAAE,EADU;QAEdN,WAAW,EAAE,EAFC;QAGdC,WAAW,EAAE,EAHC;QAIdC,aAAa,EAAE,IAJD;QAKdC,OAAO,EAAE,IALK;QAMdC,oBAAoB,EAAE;MANR,CAAD,CAVV;MAmBLd;IAnBK,CAAP;EAqBD,CA5BY;;EA6BbiB,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CA/BY;;EAgCbC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACTzB,gBAAgB,CAAC,KAAKU,IAAN,EAAY,KAAKG,MAAjB,CAAhB,CAAyCc,IAAzC,CAA+CC,GAAD,IAAS;QAAE,KAAKb,SAAL,GAAiBa,GAAjB;MAAqB,CAA9E;IACD,CAHM;;IAIPC,QAAQ,GAAE;MACP,KAAKhB,MAAL,CAAYC,MAAZ;MACCd,gBAAgB,CAAC,KAAKU,IAAN,EAAY,KAAKG,MAAjB,CAAhB,CAAyCc,IAAzC,CAA+CC,GAAD,IAAS;QAAE,KAAKb,