{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { autoIdParamOptions, typeNameParamOptions } from \"@/data/parameters\";\nimport { ref } from \"vue\";\nexport default {\n  name: \"RepairCountAndCostQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        autoIdParam: null,\n        typeNameParam: null,\n        startDateParam: null,\n        endDateParam: null\n      },\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.updateData();\n  },\n\n  methods: {\n    updateData() {\n      console.log(this.params.startDateParam);\n      console.log(this.params.endDateParam);\n      getTableRecords(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    }\n\n  },\n\n  setup() {\n    const allTypeNameOptions = ref(typeNameParamOptions);\n    const allAutoOptions = ref(autoIdParamOptions);\n    return {\n      allTypeNameOptions,\n      allAutoOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AA6CA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,kBAAR,EAA4BC,oBAA5B,QAAuD,mBAAvD;AACA,SAAQC,GAAR,QAAkB,KAAlB;AAEA,eAAe;EACbC,IAAI,EAAE,yBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,MAAM,EAAE;QACNC,WAAW,EAAE,IADP;QAENC,aAAa,EAAE,IAFT;QAGNC,cAAc,EAAE,IAHV;QAINC,YAAY,EAAE;MAJR,CADH;MAOLC,SAAS,EAAE;IAPN,CAAP;EAQD,CAfY;;EAgBbC,OAAO,GAAG;IACR,KAAKC,UAAL;EACD,CAlBY;;EAmBbC,OAAO,EAAE;IACPD,UAAU,GAAG;MACXE,OAAO,CAACC,GAAR,CAAY,KAAKV,MAAL,CAAYG,cAAxB;MACAM,OAAO,CAACC,GAAR,CAAY,KAAKV,MAAL,CAAYI,YAAxB;MACAb,eAAe,CAAC,KAAKM,IAAN,EAAY,KAAKG,MAAjB,CAAf,CAAwCW,IAAxC,CAA8CC,GAAD,IAAS;QAAE,KAAKP,SAAL,GAAiBO,GAAjB;MAAqB,CAA7E;IACF;;EALO,CAnBI;;EA0BbC,KAAK,GAAG;IACN,MAAMC,kBAAiB,GAAIpB,GAAG,CAACD,oBAAD,CAA9B;IACA,MAAMsB,cAAa,GAAIrB,GAAG,CAACF,kBAAD,CAA1B;IACA,OAAO;MAACsB,kBAAD;MAAqBC;IAArB,CAAP;EACF;;AA9Ba,CAAf","names":["getTableRecords","autoIdParamOptions","typeNameParamOptions","ref","name","props","link","String","data","params","autoIdParam","typeNameParam","startDateParam","endDateParam","tableData","mounted","updateData","methods","console","log","then","ret","setup","allTypeNameOptions","allAutoOptions"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\work\\bdbdbdbdbdbd\\1\\1lab\\frontend\\src\\components\\Queries\\RepairCountAndCostQuery.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n    <div class=\"all\">\n      <div class=\"selectDropdown\">\n        <el-select-v2\n            v-model=\"this.params.autoIdParam\"\n            :options=\"this.allAutoOptions\"\n            placeholder=\"Select Auto Id\"\n        />\n      </div>\n\n      <div class=\"selectDropdown\">\n        <el-select-v2\n            v-model=\"this.params.typeNameParam\"\n            :options=\"this.allTypeNameOptions\"\n            placeholder=\"Select Type\"\n        />\n      </div>\n\n      <div class=\"date\">\n        <el-date-picker v-model=\"this.params.startDateParam\"\n                        type=\"date\"\n                        placeholder=\"Pick Start Date\"\n                        format=\"YYYY/MM/DD\"\n                        value-format=\"YYYY-MM-DD\"/>\n      </div>\n\n      <div class=\"date\">\n        <el-date-picker v-model=\"this.params.endDateParam\"\n                        type=\"date\"\n                        placeholder=\"Pick End Date\"\n                        format=\"YYYY/MM/DD\"\n                        value-format=\"YYYY-MM-DD\"/>\n      </div>\n      <el-button class=\"submit\" type=\"success\" round @click=\"this.updateData()\">Submit</el-button>\n    </div>\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {autoIdParamOptions, typeNameParamOptions} from \"@/data/parameters\";\nimport {ref} from \"vue\";\n\nexport default {\n  name: \"RepairCountAndCostQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {\n      params: {\n        autoIdParam: null,\n        typeNameParam: null,\n        startDateParam: null,\n        endDateParam: null\n      },\n      tableData: {}}\n  },\n  mounted() {\n    this.updateData()\n  },\n  methods: {\n    updateData() {\n      console.log(this.params.startDateParam)\n      console.log(this.params.endDateParam)\n      getTableRecords(this.link, this.params).then((ret) => { this.tableData = ret})\n    }\n  },\n  setup() {\n    const allTypeNameOptions = ref(typeNameParamOptions)\n    const allAutoOptions = ref(autoIdParamOptions)\n    return {allTypeNameOptions, allAutoOptions}\n  }\n}\n</script>\n\n<style scoped>\n.submit {\n  margin-left: 20px;\n  margin-bottom: 30px;\n}\n\n.selectDropdown {\n  margin-left: 20px;\n  margin-right: 20px;\n  margin-bottom: 30px;\n}\n\n.date {\n  margin-left: 20px;\n  margin-right: 20px;\n  margin-bottom: 30px;\n}\n\n.all {\n  display: inline-flex;\n}\n\nh1 {\n  position: center;\n  font-size: 50px;\n  font-family: \"Akshar\";\n}\n</style>"]},"metadata":{},"sourceType":"module"}