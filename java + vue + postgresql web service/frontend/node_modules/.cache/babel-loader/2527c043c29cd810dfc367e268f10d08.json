te\"\n                        type=\"date\"\n                        placeholder=\"Pick End Date\"\n                        format=\"YYYY/MM/DD\"\n                        value-format=\"YYYY-MM-DD\"/>\n      </div>\n      <el-button class=\"submit\" type=\"success\" round @click=\"this.updateData()\">Submit</el-button>\n    </div>\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\n\nexport default {\n  name: \"PurchasedQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {\n      params: {\n        startDate: null,\n        endDate: null\n      },\n      tableData: {}}\n  },\n  mounted() {\n    this.updateData()\n  },\n  methods: {\n    updateData() {\n      console.log(this.params.startDate)\n      console.log(this.params.endDate)\n      getTableRecords(this.link, this.params).then((ret) => { this.tableData = ret})\n    }\n  }\n}\n</script>\n\n<style scoped>\n.submit {\n  margin-left: 20px;\n  margin-bottom: 30px;\n}\n\n.date {\n  margin-left: 20px;\n  margin-right: 20px;\n  margin-bottom: 30px;\n}\n\n.all {\n  display: inline-flex;\n}\n\nh1 {\n  position: center;\n  font-size: 50px;\n  font-family: \"Akshar\";\n}\n</style>"]},"metadata":{},"sourceType":"module"}