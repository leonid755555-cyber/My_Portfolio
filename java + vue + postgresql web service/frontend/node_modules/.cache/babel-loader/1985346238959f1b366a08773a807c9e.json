{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { personIdParamOptions, typeNameParamOptions } from \"@/data/parameters\";\nimport { ref } from \"vue\";\nexport default {\n  name: \"RepairInfoQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      params: {\n        personIdParam: null,\n        startDateParam: null,\n        endDateParam: null,\n        typeNameParam: null\n      },\n      tableData: {}\n    };\n  },\n\n  mounted() {\n    this.updateData();\n  },\n\n  methods: {\n    updateData() {\n      console.log(this.params.startDateParam);\n      console.log(this.params.endDateParam);\n      getTableRecords(this.link, this.params).then(ret => {\n        this.tableData = ret;\n      });\n    }\n\n  },\n\n  setup() {\n    const allPersonOptions = ref(personIdParamOptions);\n    const allTypeNameOptions = ref(typeNameParamOptions);\n    return {\n      allPersonOptions,\n      allTypeNameOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AA8CA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,oBAAR,EAA8BC,oBAA9B,QAAyD,mBAAzD;AACA,SAAQC,GAAR,QAAkB,KAAlB;AAEA,eAAe;EACbC,IAAI,EAAE,iBADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,MAAM,EAAE;QACNC,aAAa,EAAE,IADT;QAENC,cAAc,EAAE,IAFV;QAGNC,YAAY,EAAE,IAHR;QAINC,aAAa,EAAE;MAJT,CADH;MAOLC,SAAS,EAAE;IAPN,CAAP;EAQD,CAfY;;EAgBbC,OAAO,GAAG;IACR,KAAKC,UAAL;EACD,CAlBY;;EAmBbC,OAAO,EAAE;IACPD,UAAU,GAAG;MACXE,OAAO,CAACC,GAAR,CAAY,KAAKV,MAAL,CAAYE,cAAxB;MACAO,OAAO,CAACC,GAAR,CAAY,KAAKV,MAAL,CAAYG,YAAxB;MACAZ,eAAe,CAAC,KAAKM,IAAN,EAAY,KAAKG,MAAjB,CAAf,CAAwCW,IAAxC,CAA8CC,GAAD,IAAS;QAAE,KAAKP,SAAL,GAAiBO,GAAjB;MAAqB,CAA7E;IACF;;EALO,CAnBI;;EA0BbC,KAAK,GAAG;IACN,MAAMC,gBAAe,GAAIpB,GAAG,CAACF,oBAAD,CAA5B;IACA,MAAMuB,kBAAiB,GAAIrB,GAAG,CAACD,oBAAD,CAA9B;IACA,OAAO;MAACqB,gBAAD;MAAmBC;IAAnB,CAAP;EACF;;AA9Ba,CAAf","names":["getTableRecords","personIdParamOptions","typeNameParamOptions","ref","name","props","link","String","data","params","personIdParam","startDateParam","endDateParam","typeNameParam","tableData","mounted","updateData","methods","console","log","then","ret","setup","allPersonOptions","allTypeNameOptions"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\work\\bdbdbdbdbdbd\\1\\1lab\\frontend\\src\\components\\Queries\\RepairInfoQuery.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n    <div class=\"all\">\n\n      <div class=\"selectDropdown\">\n        <el-select-v2\n            v-model=\"this.params.personIdParam\"\n            :options=\"this.allPersonOptions\"\n            placeholder=\"Select Person\"\n        />\n      </div>\n\n      <div class=\"selectDropdown\">\n        <el-select-v2\n            v-model=\"this.params.typeNameParam\"\n            :options=\"this.allTypeNameOptions\"\n            placeholder=\"Select Type\"\n        />\n      </div>\n\n      <div class=\"date\">\n        <el-date-picker v-model=\"this.params.startDateParam\"\n                        type=\"date\"\n                        placeholder=\"Pick Start Date\"\n                        format=\"YYYY/MM/DD\"\n                        value-format=\"YYYY-MM-DD\"/>\n      </div>\n\n      <div class=\"date\">\n        <el-date-picker v-model=\"this.params.endDateParam\"\n                        type=\"date\"\n                        placeholder=\"Pick End Date\"\n                        format=\"YYYY/MM/DD\"\n                        value-format=\"YYYY-MM-DD\"/>\n      </div>\n      <el-button class=\"submit\" type=\"success\" round @click=\"this.updateData()\">Submit</el-button>\n    </div>\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {personIdParamOptions, typeNameParamOptions} from \"@/data/parameters\";\nimport {ref} from \"vue\";\n\nexport default {\n  name: \"RepairInfoQuery\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {\n      params: {\n        personIdParam: null,\n        startDateParam: null,\n        endDateParam: null,\n        typeNameParam: null\n      },\n      tableData: {}}\n  },\n  mounted() {\n    this.updateData()\n  },\n  methods: {\n    updateData() {\n      console.log(this.params.startDateParam)\n      console.log(this.params.endDateParam)\n      getTableRecords(this.link, this.params).then((ret) => { this.tableData = ret})\n    }\n  },\n  setup() {\n    const allPersonOptions = ref(personIdParamOptions)\n    const allTypeNameOptions = ref(typeNameParamOptions)\n    return {allPersonOptions, allTypeNameOptions}\n  }\n}\n</script>\n\n<style scoped>\n.submit {\n  margin-left: 20px;\n  margin-bottom: 30px;\n}\n\n.selectDropdown {\n  margin-left: 20px;\n  margin-right: 20px;\n  margin-bottom: 30px;\n}\n\n.date {\n  margin-left: 20px;\n  margin-right: 20px;\n  margin-bottom: 30px;\n}\n\n.all {\n  display: inline-flex;\n}\n\nh1 {\n  position: center;\n  font-size: 50px;\n  font-family: \"Akshar\";\n}\n</style>"]},"metadata":{},"sourceType":"module"}