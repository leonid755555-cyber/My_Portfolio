{"ast":null,"code":"import { getTableRecords } from \"@/getTableRecords\";\nimport { ElMessage, ElMessageBox } from \"element-plus\";\nimport axios from \"axios\";\nimport { reactive, ref } from \"vue\";\nimport { brigadierIdParamOptions } from \"@/data/parameters\";\nexport default {\n  name: \"BrigadeTable\",\n  props: {\n    link: String,\n    name: String\n  },\n\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        worker: {\n          id: ''\n        }\n      }),\n      params: {\n        brigadierIdParam: ''\n      }\n    };\n  },\n\n  mounted() {\n    this.getTable();\n  },\n\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then(ret => {\n        this.tableData = ret;\n      });\n    },\n\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id;\n\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\", 'Warning', {\n        confirmButtonText: 'OK',\n        cancelButtonText: 'Cancel',\n        type: 'warning'\n      })) {\n        try {\n          await axios.delete(this.link + \"/\" + id);\n          this.tableData.rows.splice(idx, 1);\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted'\n          });\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted'\n          });\n        }\n      }\n    },\n\n    async createEntity() {\n      try {\n        await axios.post(this.link, this.form);\n        this.getTable();\n      } catch (e) {\n        console.log(e);\n      }\n    }\n\n  },\n\n  setup() {\n    const allBrigadierOptions = ref(brigadierIdParamOptions);\n    return {\n      allBrigadierOptions\n    };\n  }\n\n};","map":{"version":3,"mappings":"AAmCA,SAAQA,eAAR,QAA8B,mBAA9B;AACA,SAAQC,SAAR,EAAmBC,YAAnB,QAAsC,cAAtC;AACA,OAAOC,KAAP,MAAkB,OAAlB;AACA,SAAQC,QAAR,EAAkBC,GAAlB,QAA4B,KAA5B;AACA,SAAQC,uBAAR,QAAsC,mBAAtC;AAEA,eAAe;EACbC,IAAI,EAAE,cADO;EAEbC,KAAK,EAAE;IACLC,IAAI,EAAEC,MADD;IAELH,IAAI,EAAEG;EAFD,CAFM;;EAMbC,IAAI,GAAG;IACL,OAAO;MACLC,SAAS,EAAE,EADN;MAELC,IAAI,EAAET,QAAQ,CAAC;QACbU,MAAM,EAAE;UAACC,EAAE,EAAE;QAAL;MADK,CAAD,CAFT;MAKLC,MAAM,EAAE;QAACC,gBAAgB,EAAE;MAAnB;IALH,CAAP;EAOD,CAdY;;EAebC,OAAO,GAAG;IACR,KAAKC,QAAL;EACD,CAjBY;;EAkBbC,OAAO,EAAE;IACPD,QAAQ,GAAG;MACTnB,eAAe,CAAC,KAAKS,IAAN,EAAY,IAAZ,CAAf,CAAiCY,IAAjC,CAAuCC,GAAD,IAAS;QAAE,KAAKV,SAAL,GAAiBU,GAAjB;MAAqB,CAAtE;IACD,CAHM;;IAIP,MAAMC,YAAN,CAAmBC,GAAnB,EAAwB;MACtB,IAAIT,EAAC,GAAI,KAAKH,SAAL,CAAea,IAAf,CAAoBD,GAApB,EAAyBT,EAAlC;;MACA,IAAI,MAAMb,YAAY,CAACwB,OAAb,CAAqB,2CAArB,EACN,SADM,EAEN;QACEC,iBAAiB,EAAE,IADrB;QAEEC,gBAAgB,EAAE,QAFpB;QAGEC,IAAI,EAAE;MAHR,CAFM,CAAV,EAMQ;QACN,IAAI;UACF,MAAM1B,KAAK,CAAC2B,MAAN,CAAa,KAAKrB,IAAL,GAAY,GAAZ,GAAkBM,EAA/B,CAAN;UACA,KAAKH,SAAL,CAAea,IAAf,CAAoBM,MAApB,CAA2BP,GAA3B,EAAgC,CAAhC;UACAvB,SAAS,CAAC;YACR4B,IAAI,EAAE,SADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF,CAPA,CAOE,OAAOC,CAAP,EAAU;UACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;UACAhC,SAAS,CAAC;YACR4B,IAAI,EAAE,MADE;YAERG,OAAO,EAAE;UAFD,CAAD,CAAT;QAIF;MACF;IACD,CA5BM;;IA6BP,MAAMI,YAAN,GAAqB;MACnB,IAAI;QACF,MAAMjC,KAAK,CAACkC,IAAN,CAAW,KAAK5B,IAAhB,EAAsB,KAAKI,IAA3B,CAAN;QACA,KAAKM,QAAL;MACF,CAHA,CAGE,OAAOc,CAAP,EAAU;QACVC,OAAO,CAACC,GAAR,CAAYF,CAAZ;MACF;IACF;;EApCO,CAlBI;;EAwDbK,KAAK,GAAG;IACN,MAAMC,mBAAkB,GAAIlC,GAAG,CAACC,uBAAD,CAA/B;IACA,OAAO;MAACiC;IAAD,CAAP;EACF;;AA3Da,CAAf","names":["getTableRecords","ElMessage","ElMessageBox","axios","reactive","ref","brigadierIdParamOptions","name","props","link","String","data","tableData","form","worker","id","params","brigadierIdParam","mounted","getTable","methods","then","ret","deleteEntity","idx","rows","confirm","confirmButtonText","cancelButtonText","type","delete","splice","message","e","console","log","createEntity","post","setup","allBrigadierOptions"],"sourceRoot":"","sources":["C:\\Users\\Leonid\\Desktop\\nsu-database-main\\frontend\\src\\components\\Tables\\BrigadeTable.vue"],"sourcesContent":["<template>\n  <div>\n    <h1>{{ this.name }}</h1>\n\n    <div class=\"createForm\">\n      <el-form :model=\"form\">\n        <el-form-item label=\"Brigadier Full Name\">\n          <el-select-v2\n              class=\"selectDropdown\"\n              v-model=\"form.worker.id\"\n              :options=\"this.allBrigadierOptions\"\n              placeholder=\"Select Brigadier\"\n          />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button class=\"submit\" type=\"success\" round @click=\"createEntity\">Create</el-button>\n\n        </el-form-item>\n      </el-form>\n    </div>\n\n    <el-table :data=\"tableData.rows\" style=\"width: 100%\">\n      <el-table-column v-for=\"column in this.tableData.columns\"\n                       v-bind:key=\"column.field\" :prop=\"column.field\" :label=\"column.headerName\"/>\n      <el-table-column label=\"Delete Record\">\n        <template #default=\"scope\">\n          <el-button type=\"danger\" round  v-on:click=\"deleteEntity(scope.$index)\">Delete</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport {getTableRecords} from \"@/getTableRecords\";\nimport {ElMessage, ElMessageBox} from \"element-plus\";\nimport axios from \"axios\";\nimport {reactive, ref} from \"vue\";\nimport {brigadierIdParamOptions} from \"@/data/parameters\";\n\nexport default {\n  name: \"BrigadeTable\",\n  props: {\n    link: String,\n    name: String\n  },\n  data() {\n    return {\n      tableData: {},\n      form: reactive({\n        worker: {id: ''}\n      }),\n      params: {brigadierIdParam: ''},\n    }\n  },\n  mounted() {\n    this.getTable()\n  },\n  methods: {\n    getTable() {\n      getTableRecords(this.link, null).then((ret) => { this.tableData = ret})\n    },\n    async deleteEntity(idx) {\n      let id = this.tableData.rows[idx].id\n      if (await ElMessageBox.confirm(\"Do you really want to delete this record?\",\n          'Warning',\n          {\n            confirmButtonText: 'OK',\n            cancelButtonText: 'Cancel',\n            type: 'warning',\n          })) {\n        try {\n          await axios.delete(this.link + \"/\" + id)\n          this.tableData.rows.splice(idx, 1)\n          ElMessage({\n            type: 'success',\n            message: 'Successfully deleted',\n          })\n        } catch (e) {\n          console.log(e);\n          ElMessage({\n            type: 'info',\n            message: 'Unsuccessfully deleted',\n          });\n        }\n      }\n    },\n    async createEntity() {\n      try {\n        await axios.post(this.link, this.form)\n        this.getTable()\n      } catch (e) {\n        console.log(e);\n      }\n    }\n  },\n  setup() {\n    const allBrigadierOptions = ref(brigadierIdParamOptions)\n    return {allBrigadierOptions}\n  }\n}\n</script>\n\n<style scoped>\n.createForm {\n  width: 520px;\n  margin-left: 35%;\n  border: 2px solid #22c0c2;\n  border-radius: 20px;\n  padding: 30px 30px 15px;\n  margin-bottom: 30px;\n}\n</style>"]},"metadata":{},"sourceType":"module"}